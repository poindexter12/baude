# Tailscale auth key for the sidecar — create one at
# https://login.tailscale.com/admin/settings/keys.
# Reusable yes, ephemeral NO, pre-approved yes, tag it if you use ACLs.
# Full guidance: docs/deploy.md §1.
TS_AUTHKEY=tskey-auth-REPLACE-ME

# Host directory with your repos, mounted at /code inside the container —
# new sessions point at /code/<repo>. Defaults to ~/Code if unset.
CODE_DIR=~/Code
