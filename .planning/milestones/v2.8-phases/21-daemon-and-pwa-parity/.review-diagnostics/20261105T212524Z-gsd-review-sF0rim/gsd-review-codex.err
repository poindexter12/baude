     1	//! bauded client: poll a daemon's session list over REST and attach to its
     2	//! sessions over the raw PTY websocket. Everything is synchronous — a poll
     3	//! thread and an attach IO thread feed shared state the draw loop reads,
     4	//! mirroring how local PTYs work.
     5	
     6	use std::sync::atomic::{AtomicBool, Ordering};
     7	use std::sync::{mpsc, Arc, Mutex};
     8	use std::time::Duration;
     9	
    10	use serde::Deserialize;
    11	
    12	use baude_core::meta::HookEvent;
    13	use baude_core::pty::now_ms;
    14	use baude_core::vt100;
    15	
    16	const POLL_SECS: u64 = 3;
    17	const REQUEST_TIMEOUT: Duration = Duration::from_secs(3);
    18	
    19	/// One row of the daemon's `GET /sessions`.
    20	#[derive(Deserialize, Clone, Default)]
    21	pub struct RemoteInfo {
    22	    pub id: u64,
    23	    pub name: String,
    24	    pub title: Option<String>,
    25	    pub status: String,
    26	    pub waiting_for_ms: Option<u64>,
    27	    pub model: Option<String>,
    28	    pub permission_mode: Option<String>,
    29	    pub context_used_pct: Option<u8>,
    30	    /// The session's active 5h rate-limit window (used % + reset), mirrored
    31	    /// from `SessionInfo`. `#[serde(default)]` so an older daemon that omits
    32	    /// these deserializes to `None` (back-compat, like the fields below).
    33	    #[serde(default)]
    34	    pub rate_5h_used_pct: Option<u8>,
    35	    #[serde(default)]
    36	    pub rate_5h_resets_at_unix_s: Option<u64>,
    37	    pub branch: Option<String>,
    38	    pub session_cost_usd: Option<f64>,
    39	    /// Which source decided `status` ("hook"/"session-file"/"silence"); shown
    40	    /// in the remote info overlay so a regression to silence is observable.
    41	    #[serde(default)]
    42	    pub state_source: Option<String>,
    43	    /// The last tool the daemon-managed session ran, if any.
    44	    #[serde(default)]
    45	    pub last_tool: Option<String>,
    46	    /// PERM-04: why the session is waiting — `"permission"` / `"input"` /
    47	    /// absent. `#[serde(default)]` keeps an older daemon (which omits the
    48	    /// field) deserializing to `None` (backward-compat, mirroring the fields
    49	    /// above).
    50	    #[serde(default)]
    51	    pub waiting_reason: Option<String>,
    52	    #[serde(default)]
    53	    pub archived: bool,
    54	    /// PERF-07: the daemon SIGSTOPped this session's child under
    55	    /// `idle_child_policy = "suspend"`. `#[serde(default)]` keeps an older
    56	    /// daemon that omits the field deserializing to `false`.
    57	    #[serde(default)]
    58	    pub suspended: bool,
    59	    /// Recent (~30) tool-activity events bundled into the `/sessions` poll so
    60	    /// the remote activity overlay needs no extra round-trip. Defaults to an
    61	    /// empty Vec against an older daemon that omits the field (backward-compat,
    62	    /// mirroring the `#[serde(default)]` fields above).
    63	    #[serde(default)]
    64	    pub activity: Vec<HookEvent>,
    65	    /// BL-03: compact GSD active phase (e.g. `4`), surfaced in the remote line
    66	    /// so daemon sessions show GSD state like local ones. `#[serde(default)]`
    67	    /// for back-compat with a daemon that omits it.
    68	    #[serde(default)]
    69	    pub gsd_active_phase: Option<String>,
    70	    /// Daemon workspace source label ("explicit", "folder binding", "derived",
    71	    /// or "blank" for default). Comes from the daemon's /info endpoint.
    72	    /// `#[serde(default)]` for backward-compat with older daemons.
    73	    /// Currently stored here for testing; daemon workspace source is primarily
    74	    /// accessed from RemoteSnapshot.
    75	    #[serde(default)]
    76	    #[allow(dead_code)]
    77	    pub workspace_source: Option<String>,
    78	}
