  1822	/// Stable workspace-local path for a durable managed branch checkout.
  1823	pub fn managed_branch_worktree_path(
  1824	    repository_key: &str,
  1825	    checkout_key: u64,
  1826	    branch: &str,
  1827	) -> PathBuf {
  1828	    let sanitized = sanitize(branch);
  1829	    let mut label = String::new();
  1830	    for character in sanitized.chars() {
  1831	        if label.len() + character.len_utf8() > 48 {
  1832	            break;
  1833	        }
  1834	        label.push(character);
  1835	    }
  1836	    if label.is_empty() {
  1837	        label.push_str("branch");
  1838	    }
  1839	    worktrees_base()
  1840	        .join(&crate::workspace::active().name)
  1841	        .join(format!("repository-{repository_key}"))
  1842	        .join(format!("{label}-{checkout_key}"))
