    21	pub fn router(state: Shared) -> Router {
    22	    Router::new()
    23	        .merge(crate::web::router())
    24	        .route("/info", get(info))
    25	        .route("/sessions", get(list_sessions).post(create_session))
    26	        .route("/sessions/{id}", get(get_session).delete(delete_session))
    27	        .route(
    28	            "/sessions/{id}/messages",
    29	            get(get_messages).post(post_message),
    30	        )
    31	        .route("/sessions/{id}/interrupt", post(interrupt))
    32	        .route("/sessions/{id}/restart", post(restart))
    33	        .route("/sessions/{id}/archive", post(archive))
    34	        .route("/sessions/{id}/unarchive", post(unarchive))
    35	        .route("/sessions/{id}/queue", get(get_queue))
    36	        .route("/sessions/{id}/screen", get(get_screen))
    37	        .route("/sessions/{id}/keys", post(post_keys))
    38	        .route("/sessions/{id}/pty", get(pty_ws))
    39	        .route("/sessions/{id}/stream", get(stream))
    40	        .route("/sessions/{id}/event", post(post_event))
    41	        .route(
    42	            "/sessions/{id}/permission",
    43	            get(get_permission).post(post_permission),
    44	        )
    45	        .route("/sessions/{id}/activity", get(get_activity))
    46	        .route("/sessions/{id}/activity-stream", get(activity_stream))
    47	        .with_state(state)
    48	}
