     1	#!/usr/bin/env bash
     2	#
     3	# Run the `check` job of .github/workflows/ci.yml locally, in the same order,
     4	# so a push is not the first time the gate runs.
     5	#
     6	#   gate.sh           run the gate on this machine
     7	#   gate.sh --linux   run it in rust:1-bookworm as uid 1000, which is how the
     8	#                     Linux-only defects of v2.3 would have shown up before CI
     9	#
    10	# Every step runs unpiped and its own exit status decides the result: piping a
    11	# gate command into tail or grep reports the pipe's status and has already
    12	# masked a real `cargo fmt --check` failure once. The first failing step stops
    13	# the gate, except that the root check after the suite still runs when the suite
    14	# fails, as in CI, so a run that fails AND leaks reports both. Locally the suite
    15	# and that check run against a throwaway home; see below.
    16	#
    17	# --linux runs as non-root on purpose: as root the seed_guard write-failure test
    18	# fails spuriously, because root can write where the test expects a denial.
    19	# Cargo state for the container lives under target/linux-gate so it never
    20	# mixes with the host build.
    21	#
    22	# Exit codes: 0 every step passed, 1 a step failed, 2 usage error.
    23	set -u
    24	
    25	ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
    26	cd "$ROOT" || exit 2
    27	
    28	if [[ "${1:-}" == "--linux" ]]; then
    29	  # A linked worktree's .git is a file naming the main checkout's git dir by
    30	  # absolute path, so that dir is mounted at the same path or git cannot find
    31	  # the repository inside the container.
    32	  git_common="$(cd "$(git rev-parse --git-common-dir)" && pwd)" || exit 2
    33	  # The stock image lacks rustfmt and clippy, and uid 1000 cannot add them to
    34	  # its root-owned toolchain, so they are baked into a local image; docker's
    35	  # layer cache makes every build after the first a no-op.
    36	  printf 'FROM rust:1-bookworm\nRUN rustup component add rustfmt clippy\n' |
    37	    docker build -q -t baude-gate - >/dev/null || exit 2
    38	  exec docker run --rm -u 1000:1000 \
    39	    -v "$ROOT":/work -w /work \
    40	    -v "$git_common":"$git_common" \
    41	    -e HOME=/work/target/linux-gate/home \
    42	    -e CARGO_HOME=/work/target/linux-gate/cargo \
    43	    -e CARGO_TARGET_DIR=/work/target/linux-gate/target \
    44	    -e RUSTUP_HOME=/usr/local/rustup \
    45	    -e PATH=/usr/local/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    46	    baude-gate \
    47	    bash -c 'mkdir -p "$HOME" "$CARGO_HOME" && git config --global --add safe.directory /work && bash scripts/gate.sh'
    48	elif [[ $# -gt 0 ]]; then
    49	  echo "usage: gate.sh [--linux]" >&2
    50	  exit 2
    51	fi
    52	
    53	step() {
    54	  echo "==> $*"
    55	  "$@"
    56	  local status=$?
    57	  if [[ $status -ne 0 ]]; then
    58	    echo "FAIL ($status): $*" >&2
    59	  fi
    60	  return $status
    61	}
    62	
    63	step cargo fmt --check || exit 1
    64	step cargo clippy --all-targets -- -D warnings || exit 1
    65	step bash scripts/check-commit-message.sh --self-test || exit 1
    66	# CI checks the PR's commits against origin/main; locally that is whatever this
    67	# branch adds, and nothing on main itself.
    68	if git rev-parse --verify -q origin/main >/dev/null; then
    69	  step bash scripts/check-commit-message.sh --range origin/main..HEAD || exit 1
    70	fi
    71	step bash scripts/assert-real-roots-untouched.sh --self-test || exit 1
    72	
    73	# The suite and its root check run against a throwaway home, never the
    74	# developer's real one. On a workstation the real roots are never quiet: a
    75	# running baude rewrites its breadcrumbs under the config root, and every Claude
    76	# session, this one included, writes to the Claude root. During a suite this long
    77	# the check reported that traffic as test leakage on every run, so the local gate
    78	# could not pass while baude or Claude was open. Pointing HOME and the three
    79	# overrides into the throwaway root sends every resolver there, and anything the
    80	# suite leaks lands where the check is looking and nobody else writes. The
    81	# script's own header describes this rehearsal. CI runs the bracket against the
    82	# runner's real roots, which nothing else touches, and that stays the
    83	# authoritative check that a leak through a hard-coded path would need.
    84	#
    85	# cargo and python3 may be version-manager shims that find their toolchains
    86	# through HOME. A shim that loses its HOME can install a whole toolchain into the
    87	# throwaway one, so both resolve to real binaries first, and cargo and rustup
    88	# keep their real homes.
    89	isolated_root="$(mktemp -d "${TMPDIR:-/tmp}/baude-gate.XXXXXX")" || exit 2
    90	trap 'rm -rf "$isolated_root"' EXIT
    91	cargo_bin="$(rustup which cargo 2>/dev/null || command -v cargo)" || exit 2
    92	isolated() {
    93	  env \
    94	    HOME="$isolated_root/home" \
    95	    XDG_CONFIG_HOME="$isolated_root/home/.config" \
    96	    XDG_DATA_HOME="$isolated_root/home/.local/share" \
    97	    CLAUDE_CONFIG_DIR="$isolated_root/home/.claude" \
    98	    CARGO_HOME="${CARGO_HOME:-$HOME/.cargo}" \
    99	    RUSTUP_HOME="${RUSTUP_HOME:-$HOME/.rustup}" \
   100	    BAUDE_ASSERT_PYTHON="$(python3 -c 'import sys; print(sys.executable)')" \
   101	    PATH="$(dirname "$cargo_bin"):$PATH" \
   102	    "$@"
   103	}
   104	mkdir -p "$isolated_root/home" || exit 2
   105	
   106	step isolated bash scripts/assert-real-roots-untouched.sh before || exit 1
   107	step isolated cargo test -- --test-threads=1
   108	suite=$?
   109	step isolated bash scripts/assert-real-roots-untouched.sh after
   110	roots=$?
   111	
   112	if [[ $suite -ne 0 || $roots -ne 0 ]]; then
   113	  exit 1
   114	fi
   115	echo "gate: all steps passed"
