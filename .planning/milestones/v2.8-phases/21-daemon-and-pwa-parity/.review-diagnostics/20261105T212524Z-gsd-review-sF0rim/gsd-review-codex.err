  2434	    pub fn poll(&mut self) {
  2435	        self.reconcile_early_targeted_resume_exits();
  2436	        let mut changed = false;
  2437	        let idle = self.auto_archive_ms;
  2438	        let policy = self.idle_child_policy;
  2439	        let mut notes = Vec::new();
  2440	        for s in &mut self.sessions {
  2441	            // PERF-06: archived and exited rows are never polled for metadata;
  2442	            // they still tick so an auto-archived row can re-engage.
  2443	            if s.archived || s.claude.is_exited() {
  2444	                changed |= s.auto_archive_tick(idle);
  2445	                continue;
  2446	            }
  2447	            s.poll_meta();
  2448	            let was_archived = s.archived;
  2449	            changed |= s.auto_archive_tick(idle);
  2450	            // PERF-07: a fresh auto-archive applies the idle-child policy,
  2451	            // exactly as the TUI tick does.
  2452	            if !was_archived && s.archived && !s.archived_by_user {
  2453	                if let Some(note) = s.apply_idle_child_policy(policy) {
  2454	                    notes.push(note);
  2455	                }
  2456	            }
  2457	        }
  2458	        for note in notes {
  2459	            eprintln!("idle child policy: {note}");
  2460	        }
  2461	        if changed {
  2462	            self.save();
  2463	        }
  2464	    }
