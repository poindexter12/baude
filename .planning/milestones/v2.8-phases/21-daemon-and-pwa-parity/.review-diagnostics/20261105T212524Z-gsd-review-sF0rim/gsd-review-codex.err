    68	/// The store as it is on disk right now; absent or corrupt reads as empty.
    69	fn current(root: &Path) -> SuppressionFile {
    70	    load_json::<SuppressionFile>(&file_path(root)).0
    71	}
    72	
    73	/// Whether `path` is currently suppressed. Exact `folder_key` match only; a
    74	/// parent or sibling entry does not suppress it. Never errors: an absent or
    75	/// corrupt file reads as empty so a bad store cannot fail a launch.
    76	pub fn is_suppressed(root: &Path, path: &Path) -> bool {
    77	    current(root).entries.contains_key(&folder_key(path))
    78	}
    79	
    80	/// Forget the entry for exactly `path`. Returns `Ok(true)` when an entry was
    81	/// removed and `Ok(false)` without writing when the key or the file is
    82	/// absent, so an untouched file stays byte-identical and an absent file
    83	/// stays absent. Other entries are left intact.
    84	pub fn lift(root: &Path, path: &Path) -> io::Result<bool> {
    85	    let key = folder_key(path);
    86	    if !current(root).entries.contains_key(&key) {
    87	        return Ok(false);
    88	    }
    89	    locked_merge_write(root, &file_name(), |merged: &mut SuppressionFile| {
    90	        merged.schema_version = SCHEMA_VERSION;
    91	        merged.entries.remove(&key);
    92	    })?;
    93	    Ok(true)
    94	}
