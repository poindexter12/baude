  1353	            .repository_state
  1354	            .repositories
  1355	            .iter()
  1356	            .find(|repository| repository.observed_common_dir == common)
  1357	            .map(|repository| repository.key);
  1358	        let repository_key = match existing_repository_key {
  1359	            Some(key) => key,
  1360	            None => {
  1361	                let key = self.repository_state.allocate_repository_key()?;
  1362	                let first_seen_order = self.repository_state.allocate_first_seen_order()?;
  1363	                self.repository_state.repositories.push(SavedRepository {
  1364	                    key,
  1365	                    observed_common_dir: common,
  1366	                    observed_main_worktree: PersistedPath::from_path(
  1367	                        snapshot
  1368	                            .as_ref()
  1369	                            .map(|snapshot| snapshot.main_worktree.as_path())
  1370	                            .unwrap_or(&session.repo_root),
  1371	                    ),
  1372	                    first_seen_order,
  1373	                    health: if snapshot.is_some() {
  1374	                        RepositoryHealth::Available
  1375	                    } else {
  1376	                        RepositoryHealth::Unavailable(UnavailableCause::NotRepository)
  1377	                    },
  1378	                    physical_key: key.get().to_string(),
  1379	                });
  1380	                key
  1381	            }
  1382	        };
  1383	        let checkout_key = self.repository_state.allocate_checkout_key()?;
  1384	        let first_seen_order = self.repository_state.allocate_first_seen_order()?;
  1385	        self.repository_state.checkouts.push(SavedCheckout::new(
  1386	            checkout_key,
  1387	            repository_key,
  1388	            CheckoutRole::ManagedBranch,
  1389	            session.is_worktree,
  1390	            PersistedPath::from_path(&session.cwd),
  1391	            snapshot
  1392	                .as_ref()
  1393	                .and_then(|snapshot| snapshot.selected_worktree.branch.clone()),
  1394	            first_seen_order,
  1395	            if snapshot.is_some() {
  1396	                CheckoutLifecycle::Active
  1397	            } else {
  1398	                CheckoutLifecycle::Protected(UnavailableCause::NotRepository)
  1399	            },
  1400	            RetainedSessionState {
  1401	                name: session.name.clone(),
  1402	                cwd: PersistedPath::from_path(&session.cwd),
  1403	                repo_root: PersistedPath::from_path(&session.repo_root),
  1404	                branch: session.branch.clone(),
  1405	                is_worktree: session.is_worktree,
  1406	                shell_open: session.shell_open,
  1407	                archived: session.archived,
  1408	                archived_by_user: session.archived_by_user,
  1409	                resume_id: None,
