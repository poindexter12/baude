   106	#[derive(Clone, Default)]
   107	pub struct RemoteSnapshot {
   108	    pub sessions: Vec<RemoteInfo>,
   109	    /// `now_ms()` at fetch time — waiting timers tick client-side from here.
   110	    pub fetched_ms: u64,
   111	    pub ok: bool,
   112	    /// Daemon's workspace name from /info endpoint (for displaying daemon identity).
   113	    pub daemon_workspace: Option<String>,
   114	    /// Daemon's workspace source from /info endpoint (explicit/bound/derived/blank).
   115	    pub daemon_workspace_source: Option<String>,
   116	    /// Count of collisions detected by daemon since start.
   117	    pub daemon_collision_count: u32,
   118	}
   119	
   120	impl RemoteSnapshot {
   121	    /// Compare snapshots for meaningful changes (ignoring time-based fetched_ms).
   122	    /// Returns true if the view-relevant fields are the same.
   123	    pub fn same_view(&self, other: &Self) -> bool {
   124	        self.sessions == other.sessions
   125	            && self.ok == other.ok
   126	            && self.daemon_workspace == other.daemon_workspace
   127	            && self.daemon_workspace_source == other.daemon_workspace_source
   128	            && self.daemon_collision_count == other.daemon_collision_count
   129	    }
   130	}
   131	
   132	/// Background poller for one daemon.
   133	pub struct RemotePoller {
   134	    pub base: String,
   135	    data: Arc<Mutex<RemoteSnapshot>>,
   136	}
   137	
   138	impl RemotePoller {
   139	    pub fn start(base: String) -> RemotePoller {
   140	        let base = base.trim_end_matches('/').to_string();
   141	        let data = Arc::new(Mutex::new(RemoteSnapshot::default()));
   142	        let shared = Arc::clone(&data);
   143	        let url = format!("{base}/sessions");
   144	        let info_url = format!("{base}/info");
   145	        std::thread::spawn(move || loop {
   146	            // Fetch sessions list
   147	            let fetched = ureq::get(&url)
   148	                .timeout(REQUEST_TIMEOUT)
   149	                .call()
   150	                .ok()
   151	                .and_then(|r| r.into_json::<Vec<RemoteInfo>>().ok());
   152	
   153	            // Fetch daemon workspace info from /info
   154	            let daemon_info = ureq::get(&info_url)
   155	                .timeout(REQUEST_TIMEOUT)
   156	                .call()
   157	                .ok()
   158	                .and_then(|r| r.into_json::<serde_json::Value>().ok());
   159	
   160	            if let Ok(mut d) = shared.lock() {
   161	                match fetched {
   162	                    Some(sessions) => {
   163	                        let daemon_workspace = daemon_info
   164	                            .as_ref()
   165	                            .and_then(|v| v["workspace"].as_str())
   166	                            .map(str::to_string);
   167	                        let daemon_workspace_source = daemon_info
   168	                            .as_ref()
   169	                            .and_then(|v| v["workspace_source"].as_str())
   170	                            .map(str::to_string);
   171	                        let daemon_collision_count = daemon_info
   172	                            .as_ref()
   173	                            .and_then(|v| v["collision_count"].as_u64())
   174	                            .unwrap_or(0)
   175	                            as u32;
   176	                        *d = RemoteSnapshot {
   177	                            sessions,
   178	                            fetched_ms: now_ms(),
   179	                            ok: true,
   180	                            daemon_workspace,
   181	                            daemon_workspace_source,
   182	                            daemon_collision_count,
   183	                        }
   184	                    }
   185	                    // Keep the stale list visible, just mark it offline.
   186	                    None => d.ok = false,
   187	                }
   188	            }
   189	            std::thread::sleep(Duration::from_secs(POLL_SECS));
   190	        });
   191	        RemotePoller { base, data }
   192	    }
   193	
   194	    pub fn snapshot(&self) -> RemoteSnapshot {
   195	        self.data.lock().map(|d| d.clone()).unwrap_or_default()
   196	    }
   197	
   198	    pub fn delete(&self, id: u64) -> Result<(), String> {
   199	        ureq::delete(&format!("{}/sessions/{id}", self.base))
   200	            .timeout(REQUEST_TIMEOUT)
   201	            .call()
   202	            .map(|_| ())
   203	            .map_err(|e| short_err(&e))
   204	    }
   205	
   206	    pub fn restart(&self, id: u64) -> Result<(), String> {
   207	        ureq::post(&format!("{}/sessions/{id}/restart", self.base))
   208	            .timeout(REQUEST_TIMEOUT)
   209	            .call()
   210	            .map(|_| ())
   211	            .map_err(|e| short_err(&e))
   212	    }
   213	
   214	    /// The workspace the daemon reports serving (`GET /info`). `None` when
   215	    /// the daemon predates workspaces (404) or is unreachable.
   216	    fn daemon_workspace(&self) -> Option<String> {
   217	        ureq::get(&format!("{}/info", self.base))
   218	            .timeout(REQUEST_TIMEOUT)
   219	            .call()
   220	            .ok()
   221	            .and_then(|r| r.into_json::<serde_json::Value>().ok())
   222	            .and_then(|v| v["workspace"].as_str().map(str::to_string))
   223	    }
   224	
   225	    pub fn create(
   226	        &self,
   227	        repo: &str,
   228	        worktree: Option<&str>,
   229	        name: Option<&str>,
   230	    ) -> Result<(), String> {
   231	        // Cross-workspace guard: a daemon serves exactly one workspace (and
   232	        // thus one backend), so creating a session through a daemon bound to
   233	        // a DIFFERENT workspace would silently spawn it under the wrong
   234	        // backend and pollute the wrong session pool. Refuse loudly instead.
   235	        // A pre-workspace daemon (no /info) is claude-era: allowed only from
   236	        // the claude workspace.
   237	        let local = &baude_core::workspace::active().name;
   238	        match self.daemon_workspace() {
   239	            Some(ws) if ws == *local => {}
   240	            Some(ws) => {
   241	                return Err(format!(
   242	                "daemon serves workspace {ws:?}, not {local:?} — refusing cross-workspace session"
   243	            ))
   244	            }
   245	            None if local == "claude" => {}
   246	            None => {
   247	                return Err(format!(
   248	                "daemon reports no workspace (pre-workspace version) — refusing {local:?} session"
   249	            ))
   250	            }
   251	        }
   252	        let body = serde_json::json!({ "repo": repo, "worktree": worktree, "name": name });
   253	        ureq::post(&format!("{}/sessions", self.base))
   254	            .timeout(REQUEST_TIMEOUT)
   255	            .set("Content-Type", "application/json")
   256	            .send_string(&body.to_string())
   257	            .map(|_| ())
   258	            .map_err(|e| short_err(&e))
   259	    }
   260	
   261	    pub fn set_archived(&self, id: u64, archived: bool) -> Result<(), String> {
   262	        let action = if archived { "archive" } else { "unarchive" };
   263	        ureq::post(&format!("{}/sessions/{id}/{action}", self.base))
   264	            .timeout(REQUEST_TIMEOUT)
   265	            .call()
   266	            .map(|_| ())
   267	            .map_err(|e| short_err(&e))
   268	    }
   269	}
   270	
   271	fn short_err(e: &ureq::Error) -> String {
   272	    match e {
   273	        ureq::Error::Status(code, _) => format!("daemon said {code}"),
   274	        ureq::Error::Transport(t) => t
   275	            .message()
   276	            .map(str::to_string)
   277	            .unwrap_or_else(|| "connection failed".into()),
   278	    }
   279	}
