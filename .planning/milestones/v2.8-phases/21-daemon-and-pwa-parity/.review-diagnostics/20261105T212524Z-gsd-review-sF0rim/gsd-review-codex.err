  3943	    /// Move the live `Session` handles for the report's rows out of the App
  3944	    /// registry into the shape `removal::remove` demands. The
  3945	    /// `runtime_checkouts` / `runtime_standalones` entries stay until the
  3946	    /// core returns `Ok`, so `restore_row_runtimes` can put a handle back
  3947	    /// without rebuilding the mapping.
  3948	    fn collect_row_runtimes(
  3949	        &mut self,
  3950	        report: &baude_core::removal::RemovalReport,
  3951	    ) -> Vec<baude_core::removal::RowRuntime> {
