   407	/// with `validate_for_save` so a validation refusal never follows an
   408	/// irreversible effect, the kill stage (one `Session::kill_and_wait` per live
   409	/// row in `set.rows` order, aborting on the first survivor), the disk stage
   410	/// (forced removal of every managed worktree directory, pruning the git
   411	/// administrative entry of one that is already gone), and one `save` of the
   412	/// candidate. The in-memory state is replaced and the handles for removed
   413	/// rows are consumed only after that save returns `Ok` or reports that the
   414	/// replacement file was committed.
   415	///
   416	/// The kill unit is the whole `Session`: the agent and, when the persisted
   417	/// ownership says so, the shell. Callers hold `lifecycle::RepositoryReservations`
   418	/// for every repository in the set from before `select_rows` until this
   419	/// function has returned, including after the save, so a concurrent reopen
   420	/// cannot observe the half-committed window between the disk stage and the
   421	/// save; a crash in that window is covered by the startup reconcile, which
   422	/// re-selects a deleted directory as `DiskAction::AlreadyRemoved`.
   423	///
   424	/// On `Ok` the handles whose rows were removed have been drained from
   425	/// `runtimes` and dropped here, so the caller must drop its own registry
   426	/// entries for those rows. `RemovalReport::readers_parked` names the rows
   427	/// whose PTY reader thread was still blocked behind a process outside the
   428	/// recorded group when the handle dropped; that thread exits when the holder
   429	/// closes the terminal. On `Err` the caller keeps every handle and `*state`
   430	/// is untouched; after a parent all-or-nothing abort some of those handles
   431	/// may already be dead, which the existing exit detection reconciles.
   432	///
   433	/// This is deliberately not the close protocol or the tombstoned-removal
   434	/// protocol the TUI uses: a kill failure leaves the row exactly as it was,
   435	/// with no pending lifecycle written.
   436	pub fn remove(
   437	    state: &mut RepositoryState,
   438	    target: RemovalTarget,
   439	    runtimes: &mut Vec<RowRuntime>,
   440	    save: impl FnOnce(&crate::persist::StateFile) -> Result<(), crate::persist::SaveError>,
   441	) -> Result<RemovalReport, RemovalError> {
   442	    let set = select_rows(state, target)?;
   443	    let planned = planned_clearings(state, &set);
   444	    preflight(&set, runtimes)?;
   445	    let mut candidate = state.clone();
   446	    let removed = candidate.remove_rows(
   447	        &set.repository_keys(),
   448	        &set.checkout_keys(),
   449	        &set.standalone_keys(),
   450	    );
   451	    candidate
   452	        .validate_for_save()
   453	        .map_err(RemovalError::Validation)?;
   454	    let killed = kill_stage(&set, runtimes)?;
   455	    let disk = disk_stage(&set)?;
   456	    let (persistence, readers_parked) = persist_stage(state, candidate, &set, runtimes, save)?;
   457	    let clearing = clear_stage(&removed, state, &planned);
   458	    Ok(report_from_set(
   459	        &set,
   460	        planned,
   461	        Some(StageResults {
   462	            killed,
   463	            disk,
   464	            readers_parked,
   465	            persistence,
   466	            clearing,
   467	        }),
   468	    ))
   469	}
