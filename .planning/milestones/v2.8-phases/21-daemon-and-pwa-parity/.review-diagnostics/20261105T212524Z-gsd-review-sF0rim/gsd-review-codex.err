  1420	            .as_ref()
  1421	            .map(|snapshot| PersistedPath::from_path(&snapshot.common_dir))
  1422	            .unwrap_or_else(|| PersistedPath::from_path(repo_root));
  1423	        if !state
  1424	            .repositories
  1425	            .iter()
  1426	            .any(|repository| repository.observed_common_dir == common)
  1427	        {
  1428	            state.allocate_repository_key()?;
  1429	            state.allocate_first_seen_order()?;
  1430	        }
  1431	        state.allocate_checkout_key()?;
  1432	        state.allocate_first_seen_order()?;
  1433	        Ok(())
  1434	    }
