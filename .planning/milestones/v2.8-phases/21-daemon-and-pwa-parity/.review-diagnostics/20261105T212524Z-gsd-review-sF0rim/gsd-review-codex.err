  3794	        match target {
  3795	            RemovalTarget::Repository(_) => "repository",
  3796	            RemovalTarget::Standalone(_) => "standalone session",
  3797	            RemovalTarget::Checkout(key) => self
  3798	                .hierarchy_rows()
  3799	                .into_iter()
