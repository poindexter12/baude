  2079	        let checkout = state.allocate_checkout_key()?;
  2080	        let path = git::managed_branch_worktree_path(physical_key, checkout.get(), branch);
  2081	
  2082	        // If the path doesn't exist, we're good
  2083	        if !path.exists() {
  2084	            return Ok(checkout);
  2085	        }
  2086	        // Otherwise, the counter will increment on the next call to allocate_checkout_key
  2087	    }
  2088	
  2089	    Err(LifecycleError::Topology(format!(
  2090	        "could not allocate checkout key after {} attempts",
  2091	        MAX_ATTEMPTS
  2092	    )))
