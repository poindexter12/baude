   481	    /// outside a recorded group still holds that slave terminal open: then
   482	    /// that Pty's `reader_finished()` is false and its handle stays owned by
   483	    /// the Pty. The master and writer handles stay open until this `Session`
   484	    /// is dropped, so its owner (the registry, or `removal::remove`, which
   485	    /// takes ownership of the handles for the rows it removes) must drop it
   486	    /// promptly after `Ok`; `removal::remove` also checks `reader_finished()`
   487	    /// on every consumed Pty and lists rows still parked in
   488	    /// `RemovalReport.readers_parked`, so a thread that outlives the handle
   489	    /// is reported, never hidden.
   490	    ///
   491	    /// The error arm never touches either child mutex: a Pty error that
   492	    /// returns with its leader alive leaves that reader parked in
   493	    /// `child.wait()` under the mutex, so the pids come from the immutable
   494	    /// recorded identities rather than `Pty::pid`.
   495	    pub fn kill_and_wait(&mut self) -> std::result::Result<(), SessionTeardownError> {
   496	        // Attempt each owned process independently. A partially successful
   497	        // stop remains retryable because Pty::kill_and_wait is idempotent.
   498	        let claude = self.claude.kill_and_wait().err();
   499	        let shell = self
   500	            .shell
   501	            .as_mut()
   502	            .and_then(|shell| shell.kill_and_wait().err());
   503	        match (claude, shell) {
   504	            (None, None) => Ok(()),
   505	            (claude, shell) => {
   506	                let agent_stopped = claude.is_none();
   507	                let shell_stopped = shell.is_none();
   508	                let mut failures = Vec::new();
   509	                if let Some(error) = claude {
   510	                    failures.push(format!("agent: {error}"));
   511	                }
   512	                if let Some(error) = shell {
   513	                    failures.push(format!("shell: {error}"));
   514	                }
   515	                Err(SessionTeardownError {
   516	                    agent_pid: Some(self.claude.process_identity().pid),
   517	                    shell_pid: self
   518	                        .shell
   519	                        .as_ref()
   520	                        .map(|shell| shell.process_identity().pid),
