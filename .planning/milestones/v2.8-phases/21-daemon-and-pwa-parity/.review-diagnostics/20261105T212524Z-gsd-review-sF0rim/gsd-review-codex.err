   309	/// Assemble the gate command, including (in support builds) the child's whole
   310	/// environment. Separated from the spawn so it can run — and abort — before any
   311	/// PTY exists, and so a test can inspect the finished map deterministically.
   312	///
   313	/// **Order is the policy, in both branches.** The caller's explicit env goes in
   314	/// FIRST so opaque launch-plan values (resume ids and the like) reach the child,
   315	/// and the protected root/shell/gate keys go in LAST so no caller — and no
   316	/// inherited value — can name a root or a startup file.
   317	///
   318	/// The production branch used to do the reverse, which mattered: `GATE_SCRIPT`
   319	/// execs `"$BAUDE_GATE_SHELL" -il -c "$BAUDE_GATE_COMMAND"`, so a launch-plan
   320	/// entry named `BAUDE_GATE_COMMAND` or `BAUDE_GATE_SHELL` replaced the command
   321	/// the gate was built to run, and one named `BAUDE_GATE_TOKEN` broke the
   322	/// handshake. `env` comes from backend launch plans derived from `config.json`
   323	/// rather than from any request body, so that was defense in depth rather than a
   324	/// remote vector — but it contradicted the invariant stated three lines away
   325	/// from it, and the daemon's config is exactly the sort of thing that grows a
   326	/// remote-write endpoint later (#72, WR-04).
   327	fn build_gate_command(
   328	    command: Option<&str>,
   329	    env: &[(String, String)],
   330	    cwd: &Path,
   331	) -> CommandBuilder {
   332	    let mut cmd = CommandBuilder::new("/bin/sh");
   333	    cmd.args(["-c", GATE_SCRIPT]);
   334	    cmd.cwd(cwd);
   335	
   336	    #[cfg(not(any(test, feature = "test-support")))]
   337	    {
   338	        let shell = std::env::var("SHELL").unwrap_or_else(|_| "/bin/zsh".to_string());
   339	        for (key, value) in env {
   340	            cmd.env(key, value);
   341	        }
   342	        cmd.env("TERM", "xterm-256color");
   343	        cmd.env("COLORTERM", "truecolor");
   344	        cmd.env("BAUDE_GATE_TOKEN", GATE_TOKEN);
   345	        cmd.env("BAUDE_GATE_SHELL", &shell);
   346	        cmd.env("BAUDE_GATE_MODE", gate_mode(command));
   347	        cmd.env("BAUDE_GATE_COMMAND", command.unwrap_or_default());
   348	    }
   349	    #[cfg(any(test, feature = "test-support"))]
   350	    configure_test_child(&mut cmd, env, command);
   351	
   352	    cmd
   353	}
