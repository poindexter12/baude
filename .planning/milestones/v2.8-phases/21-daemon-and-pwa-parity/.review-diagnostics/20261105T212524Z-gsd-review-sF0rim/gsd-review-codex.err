   764	    fn get(path: &str) -> Request<Body> {
   765	        Request::get(path).body(Body::empty()).unwrap()
   766	    }
   767	
   768	    fn post_json(path: &str, json: &str) -> Request<Body> {
   769	        Request::post(path)
   770	            .header(header::CONTENT_TYPE, "application/json")
   771	            .body(Body::from(json.to_string()))
   772	            .unwrap()
   773	    }
