   909	    fn activate_branch_worktree(
   910	        &mut self,
   911	        repository_child: &Path,
   912	        branch: &str,
   913	        name: Option<&str>,
   914	    ) -> MutationResult<LifecycleOutcome> {
   915	        if self.persistence_dirty || self.repository_state.has_pending_activation() {
   916	            return Err(anyhow!(
   917	                "repository lifecycle is blocked while pending ownership is not durable; repair persistence and save before retrying"
   918	            )
   919	            .into());
   920	        }
   921	        let snapshot = git::discover_repository(repository_child).map_err(anyhow::Error::new)?;
   922	        let state_before = self.repository_state.clone();
   923	        let mut next = self.repository_state.clone();
   924	        let prepared = lifecycle::prepare_activation(&mut next, &snapshot, branch)
   925	            .map_err(anyhow::Error::new)?;
   926	        let pending_checkout = prepared.checkout;
   927	
   928	        // Track collision report if detected
   929	        if let Some(ref collision_report) = prepared.collision {
   930	            self.collisions.push(collision_report.clone());
   931	        }
   932	
   933	        lifecycle::record_pending_activation(&mut next, &snapshot, &prepared)
   934	            .map_err(anyhow::Error::new)?;
   935	        let repository = prepared.request.repository;
   936	        let _reservation = match self.repository_reservations.reserve(repository) {
   937	            Ok(reservation) => reservation,
   938	            Err(busy) => return Ok(busy),
   939	        };
   940	        self.repository_state = next.clone();
   941	        if let Err(error) = self.save_checked() {
   942	            if !error.replacement_committed() {
   943	                self.repository_state = state_before;
   944	            }
   945	            return Err(MutationError::Persistence(error));
   946	        }
   947	        let activation = match lifecycle::execute_activation(&mut next, repository_child, prepared)
   948	        {
   949	            Ok(activation) => activation,
   950	            Err(error) if error.recovery_child_recorded() => {
   951	                self.repository_state = next;
   952	                if let Err(save_error) = self.save_checked() {
   953	                    return Err(anyhow!(
   954	                        "{error}; recovery ownership persistence failed: {save_error}"
   955	                    )
   956	                    .into());
   957	                }
   958	                return Err(anyhow::Error::new(error).into());
   959	            }
   960	            Err(error) => {
   961	                lifecycle::clear_pending_activation(&mut next, pending_checkout);
   962	                self.repository_state = next;
   963	                if let Err(save_error) = self.save_checked() {
   964	                    return Err(anyhow!(
   965	                        "{error}; clearing pending activation ownership failed: {save_error}"
   966	                    )
   967	                    .into());
   968	                }
   969	                return Err(anyhow::Error::new(error).into());
   970	            }
   971	        };
   972	        if let Some(name) = name {
   973	            if let Some(checkout) = next
   974	                .checkouts
   975	                .iter_mut()
   976	                .find(|checkout| checkout.key == activation.checkout)
   977	            {
   978	                checkout.session.name = name.to_owned();
   979	            }
   980	        }
  1060	            })?;
  1061	        self.runtime_checkouts.insert(activation.checkout, id);
  1062	        Ok(activation.outcome(Some(id)))
  1063	    }
  1064	
  1065	    fn record_checkout_intent(
  1066	        &mut self,
  1067	        cwd: &Path,
  1068	        repo_root: &Path,
  1069	        branch: Option<String>,
  1070	        is_worktree: bool,
  1071	        name: String,
  1072	    ) -> Result<CheckoutKey> {
  1073	        let snapshot = git::discover_repository(cwd).ok();
  1074	        let common = snapshot
  1075	            .as_ref()
  1076	            .map(|snapshot| PersistedPath::from_path(&snapshot.common_dir))
  1077	            .unwrap_or_else(|| PersistedPath::from_path(repo_root));
  1078	        let repository_key = if let Some(key) = self
  1079	            .repository_state
  1080	            .repositories
  1081	            .iter()
  1082	            .find(|repository| repository.observed_common_dir == common)
  1083	            .map(|repository| repository.key)
  1084	        {
  1085	            key
  1086	        } else {
  1087	            let key = self.repository_state.allocate_repository_key()?;
  1088	            let first_seen_order = self.repository_state.allocate_first_seen_order()?;
  1089	            self.repository_state.repositories.push(SavedRepository {
  1090	                key,
  1091	                observed_common_dir: common,
  1092	                observed_main_worktree: PersistedPath::from_path(
  1093	                    snapshot
  1094	                        .as_ref()
  1095	                        .map(|snapshot| snapshot.main_worktree.as_path())
  1096	                        .unwrap_or(repo_root),
  1097	                ),
  1098	                first_seen_order,
  1099	                health: if snapshot.is_some() {
  1100	                    RepositoryHealth::Available
  1101	                } else {
  1102	                    RepositoryHealth::Unavailable(UnavailableCause::NotRepository)
  1103	                },
  1104	                physical_key: key.get().to_string(),
  1105	            });
  1106	            key
  1107	        };
  1108	        let checkout_key = self.repository_state.allocate_checkout_key()?;
  1109	        let first_seen_order = self.repository_state.allocate_first_seen_order()?;
  1110	        self.repository_state.checkouts.push(SavedCheckout::new(
  1111	            checkout_key,
  1112	            repository_key,
  1113	            CheckoutRole::ManagedBranch,
  1114	            is_worktree,
  1115	            PersistedPath::from_path(cwd),
  1116	            snapshot
  1117	                .as_ref()
  1118	                .and_then(|snapshot| snapshot.selected_worktree.branch.clone()),
  1119	            first_seen_order,
  1120	            CheckoutLifecycle::Active,
  1320	            permission_decision: None,
  1321	            child_suspended: false,
  1322	            pane_focus_shell: false,
  1323	            poll_meta_calls_for_test: std::cell::Cell::new(0),
  1324	        });
  1325	        Ok(id)
  1326	    }
