    80	impl PartialEq for RemoteInfo {
    81	    /// Compare RemoteInfo for changes relevant to the UI.
    82	    /// Excludes activity field which is UI-only and doesn't affect view changes.
    83	    fn eq(&self, other: &Self) -> bool {
    84	        self.id == other.id
    85	            && self.name == other.name
    86	            && self.title == other.title
    87	            && self.status == other.status
    88	            && self.waiting_for_ms == other.waiting_for_ms
    89	            && self.model == other.model
    90	            && self.permission_mode == other.permission_mode
    91	            && self.context_used_pct == other.context_used_pct
    92	            && self.rate_5h_used_pct == other.rate_5h_used_pct
    93	            && self.rate_5h_resets_at_unix_s == other.rate_5h_resets_at_unix_s
    94	            && self.branch == other.branch
    95	            && self.session_cost_usd == other.session_cost_usd
    96	            && self.state_source == other.state_source
    97	            && self.last_tool == other.last_tool
    98	            && self.waiting_reason == other.waiting_reason
    99	            && self.archived == other.archived
   100	            && self.suspended == other.suspended
   101	            && self.gsd_active_phase == other.gsd_active_phase
   102	            && self.workspace_source == other.workspace_source
   103	    }
   104	}
