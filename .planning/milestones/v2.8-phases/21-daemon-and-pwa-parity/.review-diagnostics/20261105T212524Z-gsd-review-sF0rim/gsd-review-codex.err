   784	    /// A fixture repository together with the redirect that contains it.
   785	    ///
   786	    /// The redirect is thread-local and drops with this value, so the owner must
   787	    /// be held in a NAMED binding for the whole test body — including across
   788	    /// every handler `await`, since that is where session creation reaches
   789	    /// managed worktree allocation. Returning a bare `TestRedirect` from the
   790	    /// helper, or letting the owner live only as a temporary, would compile and
   791	    /// leave the fixture running completely unredirected (issue #72).
   792	    struct FixtureRepo {
   793	        repo: std::path::PathBuf,
   794	        /// Struct fields drop in DECLARATION order, the reverse of locals, so
   795	        /// the identity scope is declared before the root redirect and is
   796	        /// therefore restored while its own root is still installed — mirroring
   797	        /// the acquisition order in `initialized_repo_in_workspace` (root
   798	        /// first, identity second).
   799	        _identity: baude_core::testing::TestRedirect,
   800	        _redirect: baude_core::testing::TestRedirect,
   801	    }
   802	
   803	    impl FixtureRepo {
   804	        fn path(&self) -> &Path {
   805	            &self.repo
   806	        }
   807	    }
   808	
   809	    /// The default fixture identity is the literal `claude` workspace, which is
   810	    /// exactly the identity these tests were written against and the one the
   811	    /// `persist_at_for_test` call sites pair their state with. It is a literal,
   812	    /// never the developer's configured workspace.
   813	    #[must_use = "the returned FixtureRepo owns the redirect that contains this fixture; bind it \
   814	                  to a named local that outlives every handler await"]
   815	    fn initialized_repo(root: &Path, name: &str) -> FixtureRepo {
   816	        initialized_repo_in_workspace(root, name, "claude")
   817	    }
   818	
   819	    /// The same fixture under an explicitly chosen literal workspace, for cases
   820	    /// that need two fixtures to be distinguishable by identity alone.
   935	    /// assertion is what keeps the next one from forgetting.
   936	    fn exited_tracked_manager(repo: &Path) -> (crate::manager::Shared, u64) {
   937	        assert!(
   938	            baude_core::testing::workspace_override().is_some(),
   939	            "exited_tracked_manager requires a caller-owned isolation scope: bind an \
   940	             initialized_repo (or api_scope) owner before calling it"
   941	        );
   942	        let state = Arc::new(Mutex::new(Manager::new("true".into(), false)));
   943	        let id = crate::manager::lock(&state)
   944	            .create(repo.to_str().unwrap(), None, None)
   945	            .unwrap()
   946	            .id;
   947	        crate::manager::lock(&state).track_runtime_for_test(id);
   948	        let deadline = Instant::now() + Duration::from_secs(10);
   949	        while crate::manager::lock(&state).info(id).unwrap().status != "exited" {
   950	            assert!(Instant::now() < deadline, "stub never exited");
   951	            std::thread::sleep(Duration::from_millis(50));
   952	        }
   953	        (state, id)
   954	    }
