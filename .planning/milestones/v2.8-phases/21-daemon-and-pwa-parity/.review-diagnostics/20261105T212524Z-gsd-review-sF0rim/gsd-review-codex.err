   112	/// Remove every whitespace-delimited occurrence of `token` from `cmd`,
   113	/// collapsing surrounding whitespace to single spaces. The realistic
   114	/// `claude_cmd` is simple flag tokens (no quoted spaces), so a split/rejoin is
   115	/// safe and total.
   116	fn strip_token(cmd: &str, token: &str) -> String {
   117	    cmd.split_whitespace()
   118	        .filter(|t| *t != token)
   119	        .collect::<Vec<_>>()
   120	        .join(" ")
   121	}
