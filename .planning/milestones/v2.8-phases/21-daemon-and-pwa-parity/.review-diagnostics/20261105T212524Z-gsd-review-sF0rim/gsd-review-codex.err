   509	/// What `confirm_remove_project` did with a confirmed modal.
   510	#[derive(Debug)]
   511	pub(crate) enum RemoveProjectOutcome {
   512	    /// `removal::remove` returned `Ok`: rows are gone and the state is saved.
   513	    Removed(baude_core::removal::RemovalReport),
   514	    /// The row set differs from the previewed report; the modal is refreshed
