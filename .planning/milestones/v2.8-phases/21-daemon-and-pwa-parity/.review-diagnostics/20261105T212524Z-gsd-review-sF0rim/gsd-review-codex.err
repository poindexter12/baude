   120	/// `GET /info` — daemon identity: which workspace (and thus backend) this
   121	/// daemon serves, so clients can refuse to route sessions into the wrong
   122	/// pool (the TUI's cross-workspace guard). Daemons predating workspaces
   123	/// 404 here; clients treat that as "claude workspace, old version".
   124	async fn info(State(state): State<Shared>) -> Json<serde_json::Value> {
   125	    let ws = baude_core::workspace::active();
   720	                  local that outlives every handler await"]
   721	    pub(super) fn api_scope(label: &str) -> ApiScope {
   722	        static NEXT: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
   723	        let root = std::env::temp_dir().join(format!(
   724	            "bauded-scope-{label}-{}-{}",
   725	            std::process::id(),
   726	            NEXT.fetch_add(1, std::sync::atomic::Ordering::Relaxed)
   727	        ));
   728	        let _ = std::fs::remove_dir_all(&root);
   729	        std::fs::create_dir_all(&root).unwrap();
   730	        let redirect = baude_core::testing::TestRedirect::new(&root);
   731	        let identity = baude_core::workspace::override_for_test(
   732	            &baude_core::persist::Config {
   733	                workspace: Some(label.to_string()),
   734	                ..baude_core::persist::Config::default()
   735	            },
   736	            None,
   737	        );
   738	        ApiScope {
   739	            _identity: identity,
   740	            _redirect: redirect,
   741	        }
   742	    }
   743	
   744	    /// The router together with the scope that isolates it.
   745	    ///
   746	    /// Every handler resolves the active workspace and names its state file
   747	    /// from it, so the scope must be retained for the whole test body —
   748	    /// including across every `await`, which is where session creation reaches
   749	    /// managed worktree allocation. Returning the bare router would compile and
   750	    /// run the case against the developer's real workspace and data dir.
   751	    #[must_use = "the leading ApiScope isolates this router; bind it to a named local that \
   752	                  outlives every handler await"]
   753	    fn app() -> (ApiScope, axum::Router) {
   754	        let scope = api_scope("router");
   755	        let router = super::router(Arc::new(Mutex::new(Manager::new("sleep 30".into(), false))));
   756	        (scope, router)
   757	    }
