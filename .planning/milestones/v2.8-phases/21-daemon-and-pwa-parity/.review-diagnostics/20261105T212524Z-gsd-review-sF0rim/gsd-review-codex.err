    50	/// Web Push subscription endpoints — separate state, merged by main.
    51	pub fn push_router(state: crate::push::SharedPush) -> Router {
    52	    use crate::push::{lock as plock, Subscription};
    53	
    54	    #[derive(Deserialize)]
    55	    struct SubKeys {
    56	        p256dh: String,
    57	        auth: String,
    58	    }
    59	    #[derive(Deserialize)]
    60	    struct SubscribeBody {
    61	        endpoint: String,
    62	        keys: SubKeys,
    63	    }
    64	    #[derive(Deserialize)]
    65	    struct UnsubscribeBody {
    66	        endpoint: String,
    67	    }
    68	
    69	    Router::new()
    70	        .route(
    71	            "/push/key",
    72	            get(|State(s): State<crate::push::SharedPush>| async move {
    73	                Json(serde_json::json!({ "key": plock(&s).vapid.public_b64 }))
    74	            }),
    75	        )
    76	        .route(
    77	            "/push/subscribe",
    78	            post(
    79	                |State(s): State<crate::push::SharedPush>, Json(b): Json<SubscribeBody>| async move {
    80	                    if !b.endpoint.starts_with("https://") {
    81	                        return (StatusCode::BAD_REQUEST, "endpoint must be https").into_response();
    82	                    }
    83	                    plock(&s).subscribe(Subscription {
    84	                        endpoint: b.endpoint,
    85	                        p256dh: b.keys.p256dh,
    86	                        auth: b.keys.auth,
    87	                    });
    88	                    StatusCode::CREATED.into_response()
    89	                },
    90	            )
    91	            .delete(
    92	                |State(s): State<crate::push::SharedPush>, Json(b): Json<UnsubscribeBody>| async move {
    93	                    if plock(&s).unsubscribe(&b.endpoint) {
    94	                        StatusCode::NO_CONTENT
    95	                    } else {
    96	                        StatusCode::NOT_FOUND
    97	                    }
    98	                },
    99	            ),
   100	        )
   101	        .with_state(state)
   102	}
