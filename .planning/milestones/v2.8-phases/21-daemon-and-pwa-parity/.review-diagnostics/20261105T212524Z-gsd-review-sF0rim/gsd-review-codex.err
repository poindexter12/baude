  2826	/// Cloneable reservation registry. Guards release their repository on drop.
  2827	#[derive(Clone, Debug, Default)]
  2828	pub struct RepositoryReservations {
  2829	    held: Arc<Mutex<HashMap<RepositoryKey, ReservationKind>>>,
  2830	}
  2831	
  2832	#[derive(Clone, Copy, Debug, Eq, PartialEq)]
  2833	enum ReservationKind {
  2834	    Mutation,
  2835	    Reopen(CheckoutKey),
  2836	}
  2837	
  2838	impl RepositoryReservations {
  2839	    pub fn reserve(
  2840	        &self,
  2841	        repository: RepositoryKey,
  2842	    ) -> Result<RepositoryReservation, LifecycleOutcome> {
  2843	        let mut held = self.held.lock().unwrap_or_else(|error| error.into_inner());
  2844	        if held.contains_key(&repository) {
  2845	            return Err(LifecycleOutcome::Busy { repository });
  2846	        }
  2847	        held.insert(repository, ReservationKind::Mutation);
  2848	        drop(held);
  2849	        Ok(RepositoryReservation {
  2850	            held: Arc::clone(&self.held),
  2851	            repository,
  2852	        })
  2853	    }
  2854	
  2855	    pub fn reserve_reopen(
  2856	        &self,
  2857	        repository: RepositoryKey,
  2858	        checkout: CheckoutKey,
  2859	    ) -> Result<RepositoryReservation, LifecycleOutcome> {
  2860	        let mut held = self.held.lock().unwrap_or_else(|error| error.into_inner());
  2861	        match held.get(&repository) {
  2862	            Some(ReservationKind::Reopen(held_checkout)) if *held_checkout == checkout => {
  2863	                return Err(LifecycleOutcome::ReopenPending { checkout });
  2864	            }
  2865	            Some(_) => return Err(LifecycleOutcome::Busy { repository }),
  2866	            None => {}
  2867	        }
  2868	        held.insert(repository, ReservationKind::Reopen(checkout));
  2869	        drop(held);
  2870	        Ok(RepositoryReservation {
