   120	/// `GET /info` — daemon identity: which workspace (and thus backend) this
   606	/// `GET /messages` first). Each event's id is the message uuid. The stream
   607	/// ends when the session is deleted.
   608	async fn stream(
   609	    State(state): State<Shared>,
   610	    Path(id): Path<u64>,
   611	) -> Result<Sse<impl futures_core::Stream<Item = Result<Event, Infallible>>>, ApiError> {
   612	    lock(&state).transcript_path(id).map_err(not_found)?;
   613	
   614	    let stream = async_stream::stream! {
   615	        let mut current: Option<PathBuf> = None;
   616	        let mut tail = Tail::default();
   617	        loop {
   618	            let path = match lock(&state).transcript_path(id) {
   619	                Ok(p) => p,
   620	                Err(_) => break, // session deleted
   621	            };
   622	            if let Some(path) = path {
   623	                if current.as_ref() != Some(&path) {
   624	                    // First sighting of an existing transcript: skip its
   625	                    // history. A transcript that changes mid-stream (claude
   626	                    // restarted) is all new — read it from the top.
   627	                    tail = if current.is_none() {
   628	                        Tail::end_of(&path)
   629	                    } else {
   630	                        Tail::default()
   631	                    };
   632	                    current = Some(path.clone());
   633	                }
   634	                for m in tail.read_new(&path) {
   635	                    let data = serde_json::to_string(&m).unwrap_or_default();
   636	                    yield Ok(Event::default().event("message").id(m.uuid.clone()).data(data));
   637	                }
   638	            }
   639	            tokio::time::sleep(Duration::from_millis(STREAM_POLL_MS)).await;
   640	        }
   641	    };
   642	    Ok(Sse::new(stream).keep_alive(KeepAlive::default()))
   643	}
   644	
   645	/// SSE live tail of the session's hook-event file — a standalone channel,
   646	/// independent of the chat `/stream`. Offset-tails `/tmp/baude-events-<sid>.jsonl`
   647	/// via the dedicated `EventTail` (Pitfall 1: NOT the ChatMessage `Tail`, which
   648	/// would yield zero events). Recent history is served by `GET /activity`; this
   649	/// stream carries only events appended after connect. Unknown id → 404 via the
   650	/// up-front guard. Hook events have no uuid, so no `Event::id` is set (Pitfall 2);
   651	/// ordering is append-only and the PWA does GET-then-buffer.
   652	async fn activity_stream(
   653	    State(state): State<Shared>,
   654	    Path(id): Path<u64>,
   655	) -> Result<Sse<impl futures_core::Stream<Item = Result<Event, Infallible>>>, ApiError> {
   656	    lock(&state).event_path(id).map_err(not_found)?;
   657	
   658	    let stream = async_stream::stream! {
   659	        let mut current: Option<PathBuf> = None;
   660	        let mut tail = EventTail::default();
   661	        loop {
   662	            let path = match lock(&state).event_path(id) {
   663	                Ok(p) => p,
   664	                Err(_) => break, // session deleted
   665	            };
   666	            if let Some(path) = path {
   667	                if current.as_ref() != Some(&path) {
   668	                    // First sighting of an existing event file: skip its
   669	                    // history. A rotated path (resumed/rotated Claude session)
   670	                    // is all new — read it from the top.
   671	                    tail = if current.is_none() {
   672	                        EventTail::end_of(&path)
   673	                    } else {
   674	                        EventTail::default()
   675	                    };
   676	                    current = Some(path.clone());
   677	                }
   678	                for ev in tail.read_new(&path) {
   679	                    let data = serde_json::to_string(&ev).unwrap_or_default();
   680	                    yield Ok(Event::default().event("message").data(data));
   681	                }
   682	            }
   683	            tokio::time::sleep(Duration::from_millis(STREAM_POLL_MS)).await;
   684	        }
   685	    };
   686	    Ok(Sse::new(stream).keep_alive(KeepAlive::default()))
   687	}
