   195	async function openChat(sid) {
   196	  // Connect the stream first and buffer, then load history, then merge —
   197	  // nothing can fall between history and the live tail.
   198	  state.esBuffer = [];
   199	  const es = new EventSource(`/sessions/${sid}/stream`);
   200	  state.es = es;
   201	  es.onmessage = (ev) => {
   202	    if (state.sid !== sid) return;
   203	    const m = JSON.parse(ev.data);
   204	    if (state.esBuffer) state.esBuffer.push(m);
   205	    else if (addMsg(m)) render();
   206	  };
   207	  es.onerror = () => {
   208	    // EventSource auto-reconnects; a closed session ends the stream silently.
   209	  };
   210	  try {
   211	    const history = await api(`/sessions/${sid}/messages`);
   212	    if (state.sid !== sid) return;
   213	    for (const m of history) addMsg(m);
   214	    for (const m of state.esBuffer || []) addMsg(m);
   215	    state.esBuffer = null;
   216	    render();
   217	    scrollChat(true);
   218	  } catch (e) {
   219	    if (e.status === 404) { location.hash = "#/"; toast("session is gone"); }
   220	  }
   221	}
