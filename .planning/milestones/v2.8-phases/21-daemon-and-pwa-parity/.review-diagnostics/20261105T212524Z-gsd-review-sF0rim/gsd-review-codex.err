    76	      - name: smoke test image
    77	        run: |
    78	          # The daemon appends a permission flag (PERM-01, default
    79	          # --dangerously-skip-permissions) to BAUDE_CLAUDE_CMD; the real
    80	          # `claude` accepts it but a bare `sleep` would choke and exit.
    81	          # Wrap the stand-in in `sh -c` so the appended flags land as ignored
    82	          # positionals and the process stays alive + silent → settles to
    83	          # "waiting" (what this smoke asserts).
    84	          docker run -d --rm --name smoke --init -p 8642:8642 \
    85	            -e BAUDE_CLAUDE_CMD='sh -c "sleep 60"' bauded:ci
    86	          for i in $(seq 1 20); do
    87	            curl -fsS http://127.0.0.1:8642/sessions && break || sleep 1
    88	          done
    89	          docker exec smoke sh -c 'mkdir -p /repos/demo && git -C /repos/demo init -q'
    90	          curl -fsS -X POST http://127.0.0.1:8642/sessions \
    91	            -H 'content-type: application/json' -d '{"repo":"/repos/demo"}'
    92	          # PTY settles to "waiting" after ~2s of output silence
    93	          for i in $(seq 1 15); do
    94	            curl -fsS http://127.0.0.1:8642/sessions | grep -q '"status":"waiting"' && break
    95	            sleep 1
    96	          done
    97	          curl -fsS http://127.0.0.1:8642/sessions | grep '"status":"waiting"'
    98	          docker rm -f smoke
