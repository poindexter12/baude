   301	/// A repository target fans out to every checkout whose `repository_key`
   302	/// matches, in state order, followed by the parent row. Classification is
   303	/// pure (role and `managed_by_baude` only); the one probe is a
   304	/// `symlink_metadata` on rows classified `RemoveManagedWorktree`, which
   305	/// downgrades to `AlreadyRemoved` solely on `NotFound`.
   306	pub fn select_rows(
   307	    state: &RepositoryState,
   308	    target: RemovalTarget,
   309	) -> Result<RemovalSet, RemovalError> {
   310	    let rows = match target {
   311	        RemovalTarget::Repository(key) => {
   312	            let parent = find_repository(state, key).ok_or(RemovalError::UnknownTarget(target))?;
   313	            let mut rows: Vec<PlannedRow> = state
   314	                .checkouts
   315	                .iter()
   316	                .filter(|checkout| checkout.repository_key == key)
   317	                .map(|checkout| checkout_row(checkout, parent))
   318	                .collect();
   319	            rows.push(PlannedRow {
   320	                row: RowKey::Repository(key),
   321	                path: None,
   322	                disk: DiskAction::KeepDirectory,
   323	                runtime: None,
   324	                main_worktree: Some(parent.observed_main_worktree.to_path_buf()),
   325	                common_dir: Some(parent.observed_common_dir.to_path_buf()),
