     1	// Minimal service worker: cache the app shell for installability/offline
     2	// shell; never cache API calls (they're live session state). Also receives
     3	// Web Push notifications from the daemon.
     4	const CACHE = "baude-v6";
     5	const SHELL = ["/", "/app.js", "/style.css", "/manifest.webmanifest", "/icon.svg"];
     6	
     7	self.addEventListener("install", (e) => {
     8	  e.waitUntil(caches.open(CACHE).then((c) => c.addAll(SHELL)).then(() => self.skipWaiting()));
     9	});
    10	
    11	self.addEventListener("activate", (e) => {
    12	  e.waitUntil(
    13	    caches.keys()
    14	      .then((keys) => Promise.all(keys.filter((k) => k !== CACHE).map((k) => caches.delete(k))))
    15	      .then(() => self.clients.claim())
    16	  );
    17	});
    18	
    19	self.addEventListener("fetch", (e) => {
    20	  const url = new URL(e.request.url);
    21	  const isShell = e.request.method === "GET" && url.origin === location.origin
    22	    && SHELL.includes(url.pathname);
    23	  if (!isShell) return; // API and everything else: straight to the network
    24	  // network-first so app updates roll out; cache covers offline
    25	  e.respondWith(
    26	    fetch(e.request)
    27	      .then((res) => {
    28	        const copy = res.clone();
    29	        caches.open(CACHE).then((c) => c.put(e.request, copy));
    30	        return res;
    31	      })
    32	      .catch(() => caches.match(e.request))
    33	  );
    34	});
    35	
    36	self.addEventListener("push", (e) => {
    37	  let d = {};
    38	  try { d = e.data ? e.data.json() : {}; } catch { /* non-JSON push */ }
    39	  e.waitUntil(self.registration.showNotification(d.title || "baude", {
    40	    body: d.body || "",
    41	    tag: d.tag,
    42	    icon: "/icon-192.png",
    43	    badge: "/icon-192.png",
    44	    data: d,
    45	  }));
    46	});
    47	
    48	self.addEventListener("notificationclick", (e) => {
    49	  e.notification.close();
    50	  const sid = e.notification.data && e.notification.data.sid;
    51	  const url = sid ? `/#/s/${sid}` : "/";
    52	  e.waitUntil(
    53	    clients.matchAll({ type: "window", includeUncontrolled: true }).then((list) => {
    54	      for (const c of list) {
    55	        if ("focus" in c) {
    56	          c.navigate(url);
    57	          return c.focus();
    58	        }
    59	      }
    60	      return clients.openWindow(url);
    61	    })
    62	  );
    63	});
     1	//! The phone PWA, embedded in the binary so deploying bauded deploys the
     2	//! frontend. Plain HTML/CSS/JS in ../web — no build step.
     3	
     4	use axum::http::header::{CACHE_CONTROL, CONTENT_TYPE};
     5	use axum::response::IntoResponse;
     6	use axum::routing::get;
     7	use axum::Router;
     8	
     9	use crate::manager::Shared;
    10	
    11	macro_rules! asset {
    12	    ($path:literal, $mime:literal) => {
    13	        get(|| async {
    14	            (
    15	                [
    16	                    (CONTENT_TYPE, $mime),
    17	                    // network-first; the service worker provides offline
    18	                    (CACHE_CONTROL, "no-cache"),
    19	                ],
    20	                include_bytes!(concat!("../web/", $path)).as_slice(),
    21	            )
    22	                .into_response()
    23	        })
    24	    };
    25	}
    26	
    27	pub fn router() -> Router<Shared> {
    28	    Router::new()
    29	        .route("/", asset!("index.html", "text/html; charset=utf-8"))
    30	        .route(
    31	            "/app.js",
    32	            asset!("app.js", "text/javascript; charset=utf-8"),
    33	        )
    34	        .route("/style.css", asset!("style.css", "text/css; charset=utf-8"))
    35	        .route("/sw.js", asset!("sw.js", "text/javascript; charset=utf-8"))
    36	        .route(
    37	            "/manifest.webmanifest",
    38	            asset!("manifest.webmanifest", "application/manifest+json"),
    39	        )
    40	        .route("/icon.svg", asset!("icon.svg", "image/svg+xml"))
    41	        .route("/icon-192.png", asset!("icon-192.png", "image/png"))
    42	        .route("/icon-512.png", asset!("icon-512.png", "image/png"))
    43	        .route(
    44	            "/apple-touch-icon.png",
    45	            asset!("apple-touch-icon.png", "image/png"),
    46	        )
    47	}

