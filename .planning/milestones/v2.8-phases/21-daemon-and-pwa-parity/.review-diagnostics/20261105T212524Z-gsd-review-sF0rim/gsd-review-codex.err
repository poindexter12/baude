   335	
   336	fn sidebar_action(view: ActionView, key: KeyEvent) -> SidebarAction {
   337	    let remove_project_key = matches!(key.code, KeyCode::Char('D'))
   338	        || matches!(key.code, KeyCode::Char('d')) && key.modifiers.contains(KeyModifiers::SHIFT);
   339	    if remove_project_key {
   340	        // No `can_remove` or `RetryRecovery` gate: recovery state does not
   341	        // block the force path, and a missing worktree is the already-removed
   342	        // case the core reports (D-02).
   343	        return match view.kind {
   344	            ActionKind::Remote => SidebarAction::Refuse(SidebarRefusal::RemoteRemove),
   345	            ActionKind::Repository
   346	            | ActionKind::Main
   347	            | ActionKind::Managed
   348	            | ActionKind::External
   490	    },
