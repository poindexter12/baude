   368	/// One live runtime handed to `remove`, owned for the call. The caller moves
   369	/// the `Session` out of its registry; on `Ok` the handles for removed rows
   370	/// are consumed and dropped here, on `Err` every handle stays in the Vec.
   371	pub struct RowRuntime {
   372	    pub row: RowKey,
   373	    pub session: crate::session::Session,
   374	}
   375	
   376	impl From<crate::git::ForcedRemovalError> for DiskRemovalFailure {
   377	    fn from(error: crate::git::ForcedRemovalError) -> Self {
   378	        use crate::git::ForcedRemovalError as E;
   379	        let kind = match &error {
   380	            E::OutsideManagedRoot { .. } => DiskRemovalFailureKind::OutsideManagedRoot,
   381	            E::Symlink { .. } => DiskRemovalFailureKind::Symlink,
   382	            E::IdentityMismatch { .. } => DiskRemovalFailureKind::IdentityMismatch,
   383	            E::MainWorktree { .. } => DiskRemovalFailureKind::MainWorktree,
   384	            E::NotRegistered { .. } => DiskRemovalFailureKind::NotRegistered,
   385	            E::ForeignRepository { .. } => DiskRemovalFailureKind::ForeignRepository,
   386	            E::Submodules { .. } => DiskRemovalFailureKind::Submodules,
   387	            E::CommandStart(_) => DiskRemovalFailureKind::CommandStart,
   388	            E::Fallback { .. } => DiskRemovalFailureKind::Fallback,
   389	            E::Uninspectable { .. } => DiskRemovalFailureKind::Uninspectable,
   390	            E::Marker { .. } => DiskRemovalFailureKind::Marker,
   391	            E::Postcondition { .. } => DiskRemovalFailureKind::Postcondition,
   392	        };
   393	        Self {
   394	            kind,
   395	            detail: error.to_string(),
   396	        }
   397	    }
   398	}
   399	
   400	/// Remove `target` from the saved state: stop its runtimes, remove the
   401	/// managed worktree directories it owns, then save the whole removed row set
   402	/// once.
   403	///
   404	/// Stages, in this order: `select_rows`, `preflight` (every supplied handle
   405	/// must match the persisted runtime of its row in full, one handle per row,
   406	/// no handle for a row without a persisted runtime), candidate construction
   407	/// with `validate_for_save` so a validation refusal never follows an
   408	/// irreversible effect, the kill stage (one `Session::kill_and_wait` per live
   409	/// row in `set.rows` order, aborting on the first survivor), the disk stage
   410	/// (forced removal of every managed worktree directory, pruning the git
   411	/// administrative entry of one that is already gone), and one `save` of the
   412	/// candidate. The in-memory state is replaced and the handles for removed
   413	/// rows are consumed only after that save returns `Ok` or reports that the
   414	/// replacement file was committed.
   415	///
   416	/// The kill unit is the whole `Session`: the agent and, when the persisted
   417	/// ownership says so, the shell. Callers hold `lifecycle::RepositoryReservations`
   418	/// for every repository in the set from before `select_rows` until this
   419	/// function has returned, including after the save, so a concurrent reopen
   420	/// cannot observe the half-committed window between the disk stage and the
   421	/// save; a crash in that window is covered by the startup reconcile, which
   422	/// re-selects a deleted directory as `DiskAction::AlreadyRemoved`.
   423	///
   424	/// On `Ok` the handles whose rows were removed have been drained from
   425	/// `runtimes` and dropped here, so the caller must drop its own registry
   426	/// entries for those rows. `RemovalReport::readers_parked` names the rows
   427	/// whose PTY reader thread was still blocked behind a process outside the
   428	/// recorded group when the handle dropped; that thread exits when the holder
   429	/// closes the terminal. On `Err` the caller keeps every handle and `*state`
   430	/// is untouched; after a parent all-or-nothing abort some of those handles
   431	/// may already be dead, which the existing exit detection reconciles.
   432	///
   433	/// This is deliberately not the close protocol or the tombstoned-removal
   434	/// protocol the TUI uses: a kill failure leaves the row exactly as it was,
   435	/// with no pending lifecycle written.
   436	pub fn remove(
   437	    state: &mut RepositoryState,
   438	    target: RemovalTarget,
   439	    runtimes: &mut Vec<RowRuntime>,
   440	    save: impl FnOnce(&crate::persist::StateFile) -> Result<(), crate::persist::SaveError>,
   441	) -> Result<RemovalReport, RemovalError> {
   442	    let set = select_rows(state, target)?;
   443	    let planned = planned_clearings(state, &set);
   444	    preflight(&set, runtimes)?;
   445	    let mut candidate = state.clone();
   446	    let removed = candidate.remove_rows(
   447	        &set.repository_keys(),
   448	        &set.checkout_keys(),
   449	        &set.standalone_keys(),
   450	    );
   451	    candidate
   452	        .validate_for_save()
   453	        .map_err(RemovalError::Validation)?;
   454	    let killed = kill_stage(&set, runtimes)?;
   455	    let disk = disk_stage(&set)?;
   456	    let (persistence, readers_parked) = persist_stage(state, candidate, &set, runtimes, save)?;
   457	    let clearing = clear_stage(&removed, state, &planned);
   458	    Ok(report_from_set(
   459	        &set,
   460	        planned,
   461	        Some(StageResults {
   462	            killed,
   463	            disk,
   464	            readers_parked,
   465	            persistence,
   466	            clearing,
   467	        }),
   468	    ))
   469	}
   470	
   471	/// What the real run's stages produced, handed to `report_from_set` in place
   472	/// of the preview's derivation from the planned set.
   473	struct StageResults {
   474	    killed: Vec<KilledRuntime>,
   475	    disk: DiskResults,
   476	    readers_parked: Vec<RowKey>,
   477	    persistence: PersistenceOutcome,
   478	    clearing: ClearingResults,
   479	}
   480	
   481	/// What the clearing stage removed and what it could not.
   482	struct ClearingResults {
   483	    cleared: Vec<ClearedItem>,
   484	    failures: Vec<ClearingFailure>,
   485	}
   486	
   487	/// Everything the clearing stage will attempt for `set`, derived from the
   488	/// state before the removal so the preview and the real run name the same
   489	/// items, in the stage's own order: bindings, then markers and managed
   490	/// directories, then suppression drops, then suppression adds.
   491	///
   492	/// One `Binding` per row: a repository row names its main worktree, a
   493	/// checkout row its observed path, a standalone row its canonical path. A
   494	/// folder two rows share, such as a main checkout and its repository, is
   495	/// listed once, because the stage clears it once. One `Marker` and one
   496	/// `RepositoryDir` per repository row whose stored directory exists (D-04,
   497	/// D-05); a refused key is still named as a `Marker`, because the real run
   498	/// will report it. One `SuppressionDropped` per repository row that has
   499	/// children in the store, and one `SuppressionAdded` per checkout row whose
   500	/// parent repository survives the removal (D-10).
   501	fn planned_clearings(state: &RepositoryState, set: &RemovalSet) -> Vec<ClearedItem> {
   502	    let mut planned: Vec<ClearedItem> = Vec::new();
   503	    plan_bindings(state, set, &mut planned);
   504	    let repository_keys = set.repository_keys();
   505	    let repositories: Vec<&SavedRepository> = repository_keys
   506	        .iter()
   507	        .filter_map(|key| find_repository(state, *key))
   508	        .collect();
   509	    plan_markers(&repositories, &mut planned);
   510	    plan_suppression(state, set, &repository_keys, &repositories, &mut planned);
   511	    planned
   512	}
   513	
   514	fn plan_bindings(state: &RepositoryState, set: &RemovalSet, planned: &mut Vec<ClearedItem>) {
   515	    for row in &set.rows {
   516	        let path = match row.row {
   517	            RowKey::Repository(key) => row.main_worktree.clone().or_else(|| {
   518	                find_repository(state, key)
   519	                    .map(|repository| repository.observed_main_worktree.to_path_buf())
   520	            }),
   521	            RowKey::Checkout(_) | RowKey::Standalone(_) => row.path.clone(),
   522	        };
   523	        let Some(path) = path else { continue };
   524	        let item = ClearedItem {
   525	            kind: ClearingKind::Binding,
   526	            path,
   527	        };
   528	        if !planned.contains(&item) {
   529	            planned.push(item);
   530	        }
   531	    }
   532	}
   533	
   534	/// A `Marker` and `RepositoryDir` pair per repository row whose stored
   535	/// directory exists; a refused key is named as a `Marker` alone, because the
   536	/// real run will report it under that name.
   537	fn plan_markers(repositories: &[&SavedRepository], planned: &mut Vec<ClearedItem>) {
   538	    for repository in repositories {
   539	        match repository_dir(repository) {
   540	            Ok(dir) if std::fs::symlink_metadata(&dir).is_ok() => {
   541	                planned.push(ClearedItem {
   542	                    kind: ClearingKind::Marker,
   543	                    path: dir.clone(),
   544	                });
   545	                planned.push(ClearedItem {
   546	                    kind: ClearingKind::RepositoryDir,
   547	                    path: dir,
   548	                });
   549	            }
   550	            Ok(_) | Err(RepositoryDirRefusal::LegacyKey) => {}
   551	            Err(RepositoryDirRefusal::NotSingleComponent) => planned.push(ClearedItem {
   552	                kind: ClearingKind::Marker,
   553	                path: refused_key_path(repository),
   554	            }),
   555	        }
   556	    }
   557	}
   558	
   559	/// A `SuppressionDropped` per repository row with children in the store,
   560	/// then a `SuppressionAdded` per checkout row whose parent survives. The
   561	/// store is read once, and only when a repository row is in the set.
   562	fn plan_suppression(
   563	    state: &RepositoryState,
   564	    set: &RemovalSet,
   565	    repository_keys: &[RepositoryKey],
   566	    repositories: &[&SavedRepository],
   567	    planned: &mut Vec<ClearedItem>,
   568	) {
   569	    if !repositories.is_empty() {
   570	        let store = crate::breadcrumbs::load_json::<crate::suppression::SuppressionFile>(
   571	            &crate::suppression::file_path(&crate::persist::config_dir()),
   572	        )
   573	        .0;
   574	        for repository in repositories {
   575	            let common_dir = repository.observed_common_dir.to_path_buf();
   576	            let common_key = crate::breadcrumbs::folder_key(&common_dir);
   577	            if store
   578	                .entries
   579	                .values()
   580	                .any(|entry| entry.repository_common_dir == common_key)
   581	            {
   582	                planned.push(ClearedItem {
   583	                    kind: ClearingKind::SuppressionDropped,
   584	                    path: common_dir,
   585	                });
   586	            }
   587	        }
   588	    }
   589	    for row in &set.rows {
   590	        let RowKey::Checkout(key) = row.row else {
   591	            continue;
   592	        };
   593	        let parent_removed = state
   594	            .checkouts
   595	            .iter()
   596	            .find(|checkout| checkout.key == key)
   597	            .is_none_or(|checkout| repository_keys.contains(&checkout.repository_key));
   598	        if parent_removed {
   599	            continue;
   600	        }
   601	        let Some(path) = row.path.clone() else {
   602	            continue;
   603	        };
   604	        planned.push(ClearedItem {
   605	            kind: ClearingKind::SuppressionAdded,
   606	            path,
   607	        });
   608	    }
   609	}
   610	
   611	/// Why a repository row has no managed directory for the stage to clear.
   612	#[derive(Clone, Copy, Debug, Eq, PartialEq)]
   613	enum RepositoryDirRefusal {
   614	    /// A row saved before digests carries an empty `physical_key`; it never
   615	    /// owned a `repository-<key>` directory, so the stage has nothing to do.
   616	    LegacyKey,
   617	    /// The key holds a path separator or is `.` or `..`; joined under the
   618	    /// managed root it could name a path outside it, so it is reported and
   619	    /// never joined (T-19-10).
   620	    NotSingleComponent,
   621	}
   622	
   623	/// The managed directory a repository row owns:
   624	/// `worktrees_base()/<workspace>/repository-<physical_key>`, built from the
   625	/// stored key and never from a recomputed digest of the common dir, so a
   626	/// suffixed collision directory is the one cleared (D-05).
   627	fn repository_dir(repo: &SavedRepository) -> Result<PathBuf, RepositoryDirRefusal> {
   628	    let key = repo.physical_key.as_str();
   629	    if key.is_empty() {
   630	        return Err(RepositoryDirRefusal::LegacyKey);
   631	    }
   632	    if key == "." || key == ".." || key.chars().any(|c| c == '/' || c == '\\') {
   633	        return Err(RepositoryDirRefusal::NotSingleComponent);
   634	    }
   635	    Ok(crate::git::worktrees_base()
   636	        .join(crate::workspace::active().name.as_str())
   637	        .join(format!("repository-{key}")))
   638	}
   639	
   640	/// The path a refused key is reported under: the bare directory name, never
   641	/// joined under the managed root.
   642	fn refused_key_path(repo: &SavedRepository) -> PathBuf {
   643	    PathBuf::from(format!("repository-{}", repo.physical_key))
   644	}
   645	
   646	/// Unix milliseconds for a suppression entry's `suppressed_ms`.
   647	fn unix_millis() -> u64 {
   648	    std::time::SystemTime::now()
   649	        .duration_since(std::time::UNIX_EPOCH)
   650	        .map(|elapsed| elapsed.as_millis() as u64)
   651	        .unwrap_or(0)
   652	}
   653	
   654	/// The fourth stage: forget the advisory records that would re-admit a row
   655	/// the save just committed. Runs after `persist_stage`, so it never returns
   656	/// an error and never touches the state file; a refusal or I/O failure on
   657	/// one item is reported as a `ClearingFailure` and the remaining items are
   658	/// still tried (D-14). Order: bindings, markers and managed directories,
   659	/// suppression drops, suppression adds. `removed` is what the save dropped,
   660	/// so markers and entries are keyed by the rows' stored fields; `state` is
   661	/// the surviving state, where a removed checkout's parent is looked up.
   662	fn clear_stage(
   663	    removed: &RemovedRows,
   664	    state: &RepositoryState,
   665	    planned: &[ClearedItem],
   666	) -> ClearingResults {
   667	    let mut results = ClearingResults {
   668	        cleared: Vec::new(),
   669	        failures: Vec::new(),
   670	    };
   671	    let config_dir = crate::persist::config_dir();
   672	    clear_bindings(&config_dir, planned, &mut results);
   673	    clear_markers(removed, &mut results);
   674	    update_suppression(&config_dir, removed, state, &mut results);
   675	    results
   676	}
   677	
   678	fn clear_bindings(config_dir: &Path, planned: &[ClearedItem], results: &mut ClearingResults) {
   679	    for item in planned
   680	        .iter()
   681	        .filter(|item| item.kind == ClearingKind::Binding)
   682	    {
   683	        match crate::folder_workspace::clear(Some(config_dir), &item.path) {
   684	            Ok(true) => results.cleared.push(item.clone()),
   685	            Ok(false) => {}
   686	            Err(error) => results.failures.push(ClearingFailure {
   687	                kind: item.kind,
   688	                path: item.path.clone(),
   689	                error: error.to_string(),
   690	            }),
   691	        }
   692	    }
   693	}
   694	
   695	/// One `marker::clear_owned` per removed repository row, keyed by the row's
   696	/// stored `physical_key` and `observed_common_dir` (D-04, D-05). Nothing
   697	/// recursive runs: a directory that still holds entries is reported and
   698	/// left in place (D-07).
   699	fn clear_markers(removed: &RemovedRows, results: &mut ClearingResults) {
   700	    for repository in &removed.repositories {
   701	        let dir = match repository_dir(repository) {
   702	            Ok(dir) => dir,
   703	            Err(RepositoryDirRefusal::LegacyKey) => continue,
   704	            Err(RepositoryDirRefusal::NotSingleComponent) => {
   705	                results.failures.push(ClearingFailure {
   706	                    kind: ClearingKind::Marker,
   707	                    path: refused_key_path(repository),
   708	                    error: "physical key is not a single path component".to_string(),
   709	                });
   710	                continue;
   711	            }
   712	        };
   713	        let clear =
   714	            match crate::marker::clear_owned(&dir, repository.observed_common_dir.as_bytes()) {
   715	                Ok(clear) => clear,
   716	                Err(error) => {
   717	                    results.failures.push(ClearingFailure {
   718	                        kind: ClearingKind::Marker,
   719	                        path: dir,
   720	                        error: error.to_string(),
   721	                    });
   722	                    continue;
   723	                }
   724	            };
   725	        match clear.marker {
   726	            MarkerOutcome::Removed => results.cleared.push(ClearedItem {
   727	                kind: ClearingKind::Marker,
   728	                path: dir.clone(),
   729	            }),
   730	            MarkerOutcome::Missing => {}
   731	            MarkerOutcome::Refused(refusal) => results.failures.push(ClearingFailure {
   732	                kind: ClearingKind::Marker,
   733	                path: dir.clone(),
   734	                error: format!("marker refused: {refusal:?}"),
   735	            }),
   736	        }
   737	        match clear.directory {
   738	            DirectoryOutcome::Removed => results.cleared.push(ClearedItem {
   739	                kind: ClearingKind::RepositoryDir,
   740	                path: dir,
   741	            }),
   742	            DirectoryOutcome::NotEmpty => results.failures.push(ClearingFailure {
   743	                kind: ClearingKind::RepositoryDir,
   744	                path: dir,
   745	                error: "directory not empty, left in place".to_string(),
   746	            }),
   747	            DirectoryOutcome::Missing | DirectoryOutcome::Untouched => {}
   748	        }
   749	    }
   750	}
   751	
   752	/// Garbage-collect the entries of every removed repository's children, then
   753	/// record every removed checkout whose parent survives (D-10). Repository
   754	/// parents and standalone rows write no entry of their own.
   755	fn update_suppression(
   756	    config_dir: &Path,
   757	    removed: &RemovedRows,
   758	    state: &RepositoryState,
   759	    results: &mut ClearingResults,
   760	) {
   761	    for repository in &removed.repositories {
   762	        let common_dir = repository.observed_common_dir.to_path_buf();
   763	        match crate::suppression::drop_children(config_dir, &common_dir) {
   764	            Ok(0) => {}
   765	            Ok(_) => results.cleared.push(ClearedItem {
   766	                kind: ClearingKind::SuppressionDropped,
   767	                path: common_dir,
   768	            }),
   769	            Err(error) => results.failures.push(ClearingFailure {
   770	                kind: ClearingKind::SuppressionDropped,
   771	                path: common_dir,
   772	                error: error.to_string(),
   773	            }),
   774	        }
   775	    }
   776	    let now_ms = unix_millis();
   777	    for checkout in &removed.checkouts {
   778	        if removed
   779	            .repositories
   780	            .iter()
   781	            .any(|repository| repository.key == checkout.repository_key)
   782	        {
   783	            continue;
   784	        }
   785	        let path = checkout.observed_path.to_path_buf();
   786	        let Some(parent) = find_repository(state, checkout.repository_key) else {
   787	            results.failures.push(ClearingFailure {
   788	                kind: ClearingKind::SuppressionAdded,
   789	                path,
   790	                error: "surviving parent repository row not found".to_string(),
   791	            });
   792	            continue;
   793	        };
   794	        let common_dir = parent.observed_common_dir.to_path_buf();
   795	        match crate::suppression::suppress(config_dir, &path, &common_dir, now_ms) {
   796	            Ok(()) => results.cleared.push(ClearedItem {
   797	                kind: ClearingKind::SuppressionAdded,
   798	                path,
   799	            }),
   800	            Err(error) => results.failures.push(ClearingFailure {
   801	                kind: ClearingKind::SuppressionAdded,
   802	                path,
   803	                error: error.to_string(),
   804	            }),
   805	        }
   806	    }
   807	}
   808	
   809	/// A row whose disk stage will need git must have its owning repository's
   810	/// common dir on disk now, so a repository deleted outside baude is refused

 succeeded in 2026ms:
   100	}
   101	
   102	type MutationResult<T> = std::result::Result<T, MutationError>;
   103	
   104	/// Lock the manager, recovering from poisoning (a panicked handler must not
   105	/// take the whole daemon's session list with it).
   106	pub fn lock(shared: &Shared) -> MutexGuard<'_, Manager> {
   107	    shared.lock().unwrap_or_else(|e| e.into_inner())
   108	}
   109	
   110	pub struct Manager {
   111	    sessions: Vec<Session>,
   112	    next_id: u64,
   113	    claude_cmd: String,
   114	    /// false in tests — never touch the real daemon-state.json.
   115	    persist: bool,
   116	    /// Waiting this long auto-archives a session; 0 disables.
   117	    pub auto_archive_ms: u64,
   118	    /// PERF-07: what happens to a session's child when its row is archived
   119	    /// (by the timer or by hand). Read once from config at daemon start.
   120	    pub idle_child_policy: persist::IdleChildPolicy,
   121	    /// PERM-02: per-session wake handle for the permission long-poll. Set/clear
   122	    /// pending state happens UNDER the manager lock; the bridge/handler then
   123	    /// `notified().await`s on this Arc OUTSIDE the lock so one pending
   124	    /// permission never stalls other sessions (Pitfall 4 — "decide under the
   125	    /// lock, act outside it"). `resolve_pending` fires `notify_waiters()`.
   126	    permission_notify: HashMap<u64, Arc<Notify>>,
   127	    repository_state: RepositoryState,
   128	    runtime_checkouts: HashMap<CheckoutKey, u64>,
   129	    repository_reservations: RepositoryReservations,
   130	    persistence_blocked: bool,
   131	    /// True after a failed save so API owners can surface degraded durability.
   132	    pub persistence_dirty: bool,
   133	    persistence_error: Option<String>,
   134	    /// Collisions detected during repository admissions since daemon start.
   135	    #[allow(dead_code)]
   136	    pub collisions: Vec<CollisionReport>,
   137	    #[cfg(test)]
   138	    persistence_target_for_test: Option<(PathBuf, String)>,
   139	    #[cfg(test)]
   140	    atomic_failure_for_test: Option<persist::AtomicFailure>,
   141	    #[cfg(test)]
   142	    spawn_error_for_test: Option<String>,
   143	    /// Startup timing stages (config load, state load, listener bound, etc.)
   144	    pub startup_timing: crate::timing::StartupTiming,
   145	}
   146	
   147	#[derive(Serialize)]
   148	pub struct PersistenceStatus {
   149	    pub enabled: bool,
   150	    pub blocked: bool,
   151	    pub dirty: bool,
   152	    pub error: Option<String>,
   153	}
   154	
   155	fn reconcile_legacy_session(saved: &persist::SavedSession) -> LegacyReconciliation {
   156	    match git::discover_repository(&saved.cwd) {
   157	        Ok(snapshot) => LegacyReconciliation::Available {
   158	            common_dir: PersistedPath::from_path(&snapshot.common_dir),
   159	            main_worktree: PersistedPath::from_path(&snapshot.main_worktree),
   160	            checkout_path: PersistedPath::from_path(&snapshot.selected_worktree.path),
   161	            observed_branch: snapshot.selected_worktree.branch.clone(),
   162	            checkout_role: if snapshot.selected_worktree.path == snapshot.main_worktree {
   163	                CheckoutRole::Main
   164	            } else {
   165	                CheckoutRole::ManagedBranch
   166	            },
   167	            managed_by_baude: false,
   168	        },
   169	        Err(error) => LegacyReconciliation::Unavailable {
   170	            repository_cause: UnavailableCause::Other(error.to_string()),
   171	            checkout_cause: if saved.cwd.exists() {
   172	                UnavailableCause::NotRepository
   173	            } else {
   174	                UnavailableCause::Missing
   175	            },
   176	        },
   177	    }
   178	}
   179	
   180	/// One row of `GET /sessions`.
   181	#[derive(Serialize, Clone)]
   182	pub struct SessionInfo {
   183	    pub id: u64,
   184	    pub name: String,
   185	    pub title: Option<String>,
   186	    pub status: &'static str,
   187	    /// Which source decided `status`: "hook" / "session-file" / "silence".
   188	    /// Surfaces a regression to the silence fallback (capture-but-render-lightly).
   189	    pub state_source: &'static str,
   190	    /// The last tool name Claude ran (from the hook event stream), if any.
   191	    pub last_tool: Option<String>,
   192	    /// Present while `Waiting` (blocked on us) or `Completed` (idle since a
   193	    /// clean turn end) — how long Claude has been in that idle state.
   194	    pub waiting_for_ms: Option<u64>,
   195	    /// PERM-04 + three-state status: why the session is idle —
   196	    /// `"permission"` (a pending tool-permission request, drives the
   197	    /// distinct push + PWA card), `"input"` (a generic waiting prompt),
   198	    /// `"completed"` (a clean `Stop`, calm — no push urgency), or `None` when
   199	    /// active/busy. Derived from `meta.last_notification` + the resolved
   200	    /// `Status` via `baude_core::permission::waiting_reason`.
   201	    pub waiting_reason: Option<String>,
   202	    pub model: Option<String>,
   203	    pub permission_mode: Option<String>,
   204	    pub context_used_pct: Option<u8>,
   205	    /// The session's active 5-hour rate-limit window (used % + reset time),
   206	    /// captured per-session from its statusline bridge file (`meta.rate_5h`).
   207	    /// Flat optionals (not a nested object) so an older PWA/TUI client just
   208	    /// ignores them and `#[serde(default)]` back-compat on `RemoteInfo` is free.
   209	    pub rate_5h_used_pct: Option<u8>,
   210	    pub rate_5h_resets_at_unix_s: Option<u64>,
   211	    pub branch: Option<String>,
   212	    pub cwd: String,
   213	    pub repo_root: String,
   214	    pub is_worktree: bool,
   215	    pub gsd_milestone: Option<String>,
   216	    pub gsd_phase: Option<String>,
   217	    /// BL-03: the compact active phase (e.g. `4` → rendered `ph4`), mirroring
   218	    /// what the TUI local line shows, so remote sessions + the PWA surface GSD
   219	    /// state consistently with local sessions.
   220	    pub gsd_active_phase: Option<String>,
   221	    pub session_cost_usd: Option<f64>,
   222	    pub claude_session_id: Option<String>,
   223	    pub archived: bool,
   224	    /// PERF-07: the child is SIGSTOPped under `idle_child_policy = "suspend"`.
   225	    pub suspended: bool,
   226	    /// A bounded (~30) tail of the session's recent hook events so the remote
   227	    /// TUI overlay rides the existing `/sessions` poll without an extra round
   228	    /// trip. The full ring is served by `GET /sessions/{id}/activity`.
   229	    pub activity: Vec<HookEvent>,
   230	}
   231	
   232	/// PERM-02: an in-flight tool-permission request the `permission-mcp` bridge
   233	/// POSTed, awaiting a human decision. `request_id` is bridge-generated; `ts` is
   234	/// unix-ms (the bridge owns its own deadline). Serializable so `GET
   235	/// /sessions/{id}/permission` returns it directly.
   236	#[derive(Serialize, serde::Deserialize, Clone, Debug)]
   237	pub struct PendingPermission {
   238	    pub request_id: String,
   239	    pub tool: String,
   240	    pub input: serde_json::Value,
   241	    pub ts: u64,
   242	}
   243	
   244	/// PERM-02: the human decision recorded for the most recent request. The
   245	/// bridge's GET poll reads `decision` (`allow`|`deny`) to unblock.
   246	///
   247	/// WR-03: there is deliberately NO `scope` field — scope is not enforced in
   248	/// v0.7. Carrying it here would imply a session-scoped-allow contract that does
   249	/// not exist (every `tools/call` mints a fresh request). Enforcement is
   250	/// deferred; the POST handler still accepts `scope` for forward-compat but
   251	/// discards it.
   252	#[derive(Serialize, Clone, Debug)]
   253	pub struct PermissionDecision {
   254	    pub request_id: String,
   255	    pub decision: String,
   256	    pub ts: u64,
   257	}
   258	
   259	/// `GET /sessions/{id}/permission` payload — the pending request (if any) plus
   260	/// the resolved decision (if any). While pending, `decision` is `None`; after a
   261	/// POST resolves it, `request_id`/`tool`/`input` describe the just-decided call
   262	/// and `decision` carries the verdict for the bridge poll. `None`-everywhere
   263	/// (no request ever) serializes to JSON `null` at the handler.
   264	#[derive(Serialize)]
   265	pub struct PermissionView {
   266	    pub request_id: Option<String>,
   267	    pub tool: Option<String>,
   268	    pub input: Option<serde_json::Value>,
   269	    pub ts: Option<u64>,
   270	    /// `allow` | `deny` once resolved; absent while pending or idle.
   271	    pub decision: Option<String>,
   272	}
   273	
   274	fn status_str(s: Status) -> &'static str {
   275	    match s {
   276	        Status::Waiting => "waiting",
   277	        Status::Completed => "completed",
   278	        Status::Busy => "busy",
   279	        Status::Exited => "exited",
   280	    }
   281	}
   282	
   283	fn source_str(s: StateSource) -> &'static str {
   284	    match s {
   285	        StateSource::Hook => "hook",
   286	        StateSource::SessionFile => "session-file",
   287	        StateSource::Silence => "silence",
   288	    }
   289	}
