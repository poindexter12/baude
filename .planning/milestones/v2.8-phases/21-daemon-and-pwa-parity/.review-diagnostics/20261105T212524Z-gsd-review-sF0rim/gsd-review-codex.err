  1328	    fn unique_name(&self, base: &str) -> String {
  1329	        if !self.sessions.iter().any(|s| s.name == base) {
  1330	            return base.to_string();
  1331	        }
  1332	        let mut n = 2;
  1333	        loop {
  1334	            let candidate = format!("{base} ({n})");
  1335	            if !self.sessions.iter().any(|s| s.name == candidate) {
  1336	                return candidate;
  1337	            }
  1338	            n += 1;
  1339	        }
  1340	    }
