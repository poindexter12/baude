  3801	                    LocalRow::Checkout(child) if child.key == key => {
  3802	                        Some(match child.actions.kind {
  3803	                            ActionKind::Main => "main checkout",
  3804	                            ActionKind::Managed => "managed worktree",
  3805	                            ActionKind::External => "unmanaged checkout",
  3806	                            ActionKind::Unavailable => "unavailable worktree",
  3807	                            _ => "checkout",
  3808	                        })
