   909	    fn activate_branch_worktree(
   910	        &mut self,
   911	        repository_child: &Path,
   912	        branch: &str,
   913	        name: Option<&str>,
   914	    ) -> MutationResult<LifecycleOutcome> {
   915	        if self.persistence_dirty || self.repository_state.has_pending_activation() {
   916	            return Err(anyhow!(
   917	                "repository lifecycle is blocked while pending ownership is not durable; repair persistence and save before retrying"
   918	            )
   919	            .into());
   920	        }
   921	        let snapshot = git::discover_repository(repository_child).map_err(anyhow::Error::new)?;
   922	        let state_before = self.repository_state.clone();
   923	        let mut next = self.repository_state.clone();
   924	        let prepared = lifecycle::prepare_activation(&mut next, &snapshot, branch)
   925	            .map_err(anyhow::Error::new)?;
   926	        let pending_checkout = prepared.checkout;
   927	
   928	        // Track collision report if detected
   929	        if let Some(ref collision_report) = prepared.collision {
   930	            self.collisions.push(collision_report.clone());
   931	        }
   932	
   933	        lifecycle::record_pending_activation(&mut next, &snapshot, &prepared)
   934	            .map_err(anyhow::Error::new)?;
   935	        let repository = prepared.request.repository;
   936	        let _reservation = match self.repository_reservations.reserve(repository) {
   937	            Ok(reservation) => reservation,
   938	            Err(busy) => return Ok(busy),
   939	        };
   940	        self.repository_state = next.clone();
   941	        if let Err(error) = self.save_checked() {
   942	            if !error.replacement_committed() {
   943	                self.repository_state = state_before;
   944	            }
   945	            return Err(MutationError::Persistence(error));
   946	        }
   947	        let activation = match lifecycle::execute_activation(&mut next, repository_child, prepared)
   948	        {
   949	            Ok(activation) => activation,
   950	            Err(error) if error.recovery_child_recorded() => {
   951	                self.repository_state = next;
   952	                if let Err(save_error) = self.save_checked() {
   953	                    return Err(anyhow!(
   954	                        "{error}; recovery ownership persistence failed: {save_error}"
   955	                    )
   956	                    .into());
   957	                }
   958	                return Err(anyhow::Error::new(error).into());
   959	            }
   960	            Err(error) => {
   961	                lifecycle::clear_pending_activation(&mut next, pending_checkout);
   962	                self.repository_state = next;
   963	                if let Err(save_error) = self.save_checked() {
   964	                    return Err(anyhow!(
   965	                        "{error}; clearing pending activation ownership failed: {save_error}"
   966	                    )
   967	                    .into());
   968	                }
   969	                return Err(anyhow::Error::new(error).into());
   970	            }
   971	        };
   972	        if let Some(name) = name {
   973	            if let Some(checkout) = next
   974	                .checkouts
   975	                .iter_mut()
   976	                .find(|checkout| checkout.key == activation.checkout)
   977	            {
   978	                checkout.session.name = name.to_owned();
   979	            }
   980	        }
