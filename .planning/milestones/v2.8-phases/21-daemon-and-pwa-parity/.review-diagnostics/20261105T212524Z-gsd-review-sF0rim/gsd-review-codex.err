  3816	    /// The sidebar name of a row named in a `RemovalReport`, falling back to
  3817	    /// its recorded path so a row the hierarchy no longer projects still
  3818	    /// reads as something concrete.
  3819	    pub(crate) fn removal_row_label(&self, key: &baude_core::removal::RowKey) -> String {
  3820	        use baude_core::removal::RowKey;
  3821	        let from_rows = self
  3822	            .hierarchy_rows()
  3823	            .into_iter()
  3824	            .find_map(|row| match (row, key) {
  3825	                (LocalRow::Repository(parent), RowKey::Repository(k)) if parent.key == *k => {
  3826	                    Some(parent.name)
  3827	                }
  3828	                (LocalRow::Checkout(child), RowKey::Checkout(k)) if child.key == *k => {
  3829	                    Some(child.name)
  3830	                }
  3831	                (LocalRow::Standalone(standalone), RowKey::Standalone(k))
  3832	                    if standalone.key == *k =>
  3833	                {
  3834	                    Some(standalone.name)
  3835	                }
  3836	                _ => None,
  3837	            });
  3838	        if let Some(name) = from_rows {
  3839	            return name;
  3840	        }
  3841	        let path = match key {
  3842	            RowKey::Repository(k) => self
  3843	                .repository_state
  3844	                .repositories
  3845	                .iter()
  3846	                .find(|repository| repository.key == *k)
  3847	                .map(|repository| repository.observed_main_worktree.to_path_buf()),
  3848	            RowKey::Checkout(k) => self
  3849	                .repository_state
  3850	                .checkouts
  3851	                .iter()
  3852	                .find(|checkout| checkout.key == *k)
  3853	                .map(|checkout| checkout.observed_path.to_path_buf()),
  3854	            RowKey::Standalone(k) => self
  3855	                .repository_state
  3856	                .standalone_session(*k)
  3857	                .map(|standalone| standalone.canonical_path.to_path_buf()),
  3858	        };
  3859	        path.map(|path| path.display().to_string())
  3860	            .unwrap_or_else(|| format!("{key:?}"))
  3861	    }
