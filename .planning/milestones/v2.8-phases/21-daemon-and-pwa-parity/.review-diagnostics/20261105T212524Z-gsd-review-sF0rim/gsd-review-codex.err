  3961	                continue;
  3962	            };
  3963	            let Some(index) = self
  3964	                .sessions
  3965	                .iter()
  3966	                .position(|session| session.id == runtime_id)
  3967	            else {
  3968	                continue;
  3969	            };
  3970	            runtimes.push(RowRuntime {
  3971	                row: *row,
  3972	                session: self.sessions.remove(index),
  3973	            });
  3974	        }
  3975	        runtimes
  3976	    }
