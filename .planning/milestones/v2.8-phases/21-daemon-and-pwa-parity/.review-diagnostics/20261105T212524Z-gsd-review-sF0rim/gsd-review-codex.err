   270	async fn restart(State(state): State<Shared>, Path(id): Path<u64>) -> Result<StatusCode, ApiError> {
   271	    lock(&state).restart(id).map_err(|error| {
   272	        match error {
   273	            MutationError::Persistence(error) => {
   274	                (StatusCode::SERVICE_UNAVAILABLE, error.to_string())
   275	            }
   276	            MutationError::Teardown(error) => {
   277	                (StatusCode::INTERNAL_SERVER_ERROR, error.to_string())
   278	            }
   279	            MutationError::Domain(error) => {
   280	                let message = error.to_string();
   281	                if message.starts_with("no session") {
   282	                    (StatusCode::NOT_FOUND, message)
   283	                } else {
   284	                    (StatusCode::CONFLICT, message) // still running
   285	                }
   286	            }
   287	        }
   288	    })?;
   289	    // A restart re-rolls the opencode server port — wire a fresh watcher.
   290	    crate::permission_bridge::watch_if_needed(&state, id);
   291	    Ok(StatusCode::ACCEPTED)
   292	}
   293	
   294	async fn archive(State(state): State<Shared>, Path(id): Path<u64>) -> Result<StatusCode, ApiError> {
   295	    lock(&state)
   296	        .set_archived(id, true)
   297	        .map_err(|error| mutation_error(error, StatusCode::NOT_FOUND))?;
   298	    Ok(StatusCode::NO_CONTENT)
   299	}
   300	
   301	async fn unarchive(
   302	    State(state): State<Shared>,
   303	    Path(id): Path<u64>,
   304	) -> Result<StatusCode, ApiError> {
   305	    lock(&state)
   306	        .set_archived(id, false)
   307	        .map_err(|error| mutation_error(error, StatusCode::NOT_FOUND))?;
   308	    Ok(StatusCode::NO_CONTENT)
   309	}
