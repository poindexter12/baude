   563	  div.id = "modal";
   564	  div.innerHTML = `
   565	    <form class="box" id="newform">
   566	      <h2>New session</h2>
   567	      <label for="f-repo">repo path (on the server)</label>
   568	      <input id="f-repo" placeholder="/code/myproject" autocapitalize="off" autocorrect="off">
   569	      <label for="f-branch">worktree branch — optional</label>
   570	      <input id="f-branch" placeholder="fix-thing" autocapitalize="off" autocorrect="off">
   571	      <label for="f-name">name — optional</label>
   572	      <input id="f-name" autocapitalize="off" autocorrect="off">
   573	      <div class="actions">
   574	        <button type="button" class="ghost" id="cancelnew">cancel</button>
   575	        <button type="submit" class="primary">start</button>
   576	      </div>
   577	    </form>`;
   578	  document.body.appendChild(div);
   579	  div.addEventListener("click", (e) => { if (e.target === div) closeModal(); });
   580	  document.getElementById("cancelnew").onclick = closeModal;
   581	  document.getElementById("newform").onsubmit = createSession;
   582	  document.getElementById("f-repo").focus();
   583	}
