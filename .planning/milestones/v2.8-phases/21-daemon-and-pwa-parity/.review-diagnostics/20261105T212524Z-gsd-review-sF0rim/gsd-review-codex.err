    96	/// Record that `path` was removed while the repository at `common_dir`
    97	/// survived. A later entry for the same path replaces the earlier one.
    98	pub fn suppress(root: &Path, path: &Path, common_dir: &Path, now_ms: u64) -> io::Result<()> {
    99	    let key = folder_key(path);
   100	    let entry = SuppressionEntry {
   101	        repository_common_dir: folder_key(common_dir),
   102	        suppressed_ms: now_ms,
   103	    };
   104	    locked_merge_write(root, &file_name(), |merged: &mut SuppressionFile| {
   105	        merged.schema_version = SCHEMA_VERSION;
   106	        merged.entries.insert(key, entry);
   107	    })
   108	}
