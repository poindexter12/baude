  1073	fn checkout_row(checkout: &SavedCheckout, parent: &SavedRepository) -> PlannedRow {
  1074	    let path = checkout.observed_path.to_path_buf();
  1075	    let disk = probe_disk(disk_action_for(checkout), &path);
  1076	    PlannedRow {
  1077	        row: RowKey::Checkout(checkout.key),
  1078	        path: Some(path),
  1079	        disk,
  1080	        runtime: checkout.owned_runtime().cloned(),
  1081	        main_worktree: Some(parent.observed_main_worktree.to_path_buf()),
  1082	        common_dir: Some(parent.observed_common_dir.to_path_buf()),
  1083	    }
  1084	}
  1085	
  1086	/// The per-kind disk rule from the persisted row alone: a main checkout and
  1087	/// an unmanaged checkout are kept; a managed non-main checkout is removed.
  1088	fn disk_action_for(checkout: &SavedCheckout) -> DiskAction {
  1089	    match (checkout.role, checkout.managed_by_baude) {
  1090	        (CheckoutRole::Main, _) | (_, false) => DiskAction::KeepDirectory,
  1091	        (_, true) => DiskAction::RemoveManagedWorktree,
  1092	    }
  1093	}
  1094	
  1095	/// Downgrade a managed removal to `AlreadyRemoved` only when the directory
  1096	/// is `NotFound`. Any other inspection error keeps the row so the disk stage
  1097	/// reports it as a typed failure instead of silently dropping the row.
  1098	fn probe_disk(action: DiskAction, path: &Path) -> DiskAction {
  1099	    if action != DiskAction::RemoveManagedWorktree {
  1100	        return action;
  1101	    }
  1102	    match std::fs::symlink_metadata(path) {
  1103	        Err(error) if error.kind() == ErrorKind::NotFound => DiskAction::AlreadyRemoved,
  1104	        _ => DiskAction::RemoveManagedWorktree,
  1105	    }
  1106	}
