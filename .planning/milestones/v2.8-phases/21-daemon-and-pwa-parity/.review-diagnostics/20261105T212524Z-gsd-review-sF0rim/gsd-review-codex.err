   829	        // creation reaches managed worktree allocation.
   830	        let identity = baude_core::workspace::override_for_test(
   831	            &baude_core::persist::Config {
   832	                workspace: Some(workspace.to_string()),
   833	                ..baude_core::persist::Config::default()
   834	            },
   835	            None,
   935	    /// assertion is what keeps the next one from forgetting.
