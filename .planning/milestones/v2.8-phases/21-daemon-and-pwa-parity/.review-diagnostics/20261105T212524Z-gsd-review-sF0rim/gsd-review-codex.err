   291	/// The daemon's own loopback event endpoint for a session. `Manager` does not
   292	/// store the daemon's bind addr (manager.rs has no bind field), and the hook
   293	/// only needs same-host reachability, so we use the loopback default bind
   294	/// (`DEFAULT_BIND = "127.0.0.1:8642"` in bauded/src/main.rs). Known limitation
   295	/// (out of scope for Phase 2): a custom `--bind` port is NOT honored here —
   296	/// honoring it would require threading the bind addr into `Manager`.
   297	fn event_url(id: u64) -> String {
   298	    format!("http://127.0.0.1:8642/sessions/{id}/event")
   299	}
   300	
   301	struct ManagerLifecycleEffects<'a, F> {
   302	    manager: &'a mut Manager,
   303	    effect: Option<F>,
   304	}
   305	
   306	impl<F> lifecycle::LifecycleEffects for ManagerLifecycleEffects<'_, F>
   307	where
   308	    F: FnOnce(&mut Manager, &lifecycle::LifecycleTraceEntry) -> Result<()>,
   309	{
   310	    type Error = anyhow::Error;
   311	
   312	    fn persist_lifecycle(&mut self, candidate: &lifecycle::LifecycleCandidate) -> Result<()> {
   313	        let before = self.manager.repository_state.clone();
   314	        candidate.apply(&mut self.manager.repository_state)?;
   315	        if let Err(error) = self.manager.save_checked() {
   316	            if error.replacement_committed() {
   317	                return Ok(());
   318	            } else {
   319	                self.manager.repository_state = before;
   320	            }
   321	            return Err(anyhow::Error::new(error));
   322	        }
   323	        Ok(())
   324	    }
   325	
   326	    fn apply_lifecycle_effect(&mut self, effect: &lifecycle::LifecycleTraceEntry) -> Result<()> {
   327	        self.effect
   328	            .take()
   329	            .ok_or_else(|| anyhow!("lifecycle effect invoked more than once"))?(
   330	            self.manager,
   480	            persistence_blocked: false,
   481	            persistence_dirty: false,
   482	            persistence_error: None,
   483	            collisions: Vec::new(),
   484	            #[cfg(test)]
   485	            persistence_target_for_test: None,
   486	            #[cfg(test)]
   487	            atomic_failure_for_test: None,
   488	            #[cfg(test)]
   489	            spawn_error_for_test: None,
   490	            startup_timing: crate::timing::StartupTiming::new(0),
   491	        }
   492	    }
   493	
   494	    /// Respawn every saved session with `claude --continue`. Returns how many
   495	    /// came back.
   496	    pub fn restore(&mut self) -> usize {
   497	        if !self.persist {
   498	            return 0;
   499	        }
   500	        let loaded = persist::load_for_workspace(
   501	            STATE_BASE,
   502	            baude_core::workspace::active(),
   503	            reconcile_legacy_session,
   504	        );
   505	        let restored = self.restore_loaded(loaded);
   506	        self.save();
   507	        restored
   508	    }
   509	
   510	    #[cfg(test)]
   511	    fn restore_at(&mut self, root: &Path, workspace: &baude_core::workspace::Workspace) -> usize {
   512	        if !self.persist {
   513	            return 0;
   514	        }
   515	        let loaded = persist::load_for_workspace_strict_at(
   516	            root,
   517	            STATE_BASE,
   518	            workspace,
   519	            reconcile_legacy_session,
   520	        );
   521	        let restored = self.restore_loaded(loaded);
   522	        self.save_at(root, workspace);
   523	        restored
   524	    }
   525	
   526	    fn restore_loaded(
   527	        &mut self,
   528	        loaded: std::result::Result<LoadOutcome, persist::LoadError>,
   529	    ) -> usize {
   530	        self.repository_state = match loaded {
   531	            Ok(LoadOutcome::Missing) => RepositoryState::default(),
   532	            Ok(LoadOutcome::Legacy(state) | LoadOutcome::Current(state)) => state.state,
   533	            Err(error) => {
   534	                self.persistence_blocked = true;
   535	                self.persistence_error = Some(error.to_string());
   536	                eprintln!(
   537	                    "daemon persistence blocked: {error}; repair or move the named state file, then restart"
   538	                );
   539	                return 0;
   540	            }
   541	        };
   542	        if let Err(error) = self.reconcile_teardown_recoveries() {
   543	            eprintln!("teardown recovery: {error}");
   544	        }
   545	        if let Err(error) = self.reconcile_activation_recoveries() {
   546	            eprintln!("activation recovery: {error}");
   547	        }
   548	        let checkouts: Vec<_> = self
   549	            .repository_state
   550	            .checkouts
   551	            .iter()
   552	            .filter(|checkout| {
   553	                matches!(
   554	                    checkout.lifecycle(),
   555	                    CheckoutLifecycle::Active | CheckoutLifecycle::Launching(_)
   556	                ) || (checkout.active_intent() && checkout.health() == &CheckoutHealth::Available)
   557	            })
   558	            .cloned()
   559	            .collect();
   560	        let mut restored = 0;
   561	        for checkout in checkouts {
   562	            match self.reopen_checkout(checkout.key) {
   563	                Ok(LifecycleOutcome::Reopened { .. } | LifecycleOutcome::Focused { .. }) => {
   564	                    restored += 1;
   565	                }
   695	        if let Err(error) = self.save_checked() {
   696	            if !error.replacement_committed() {
   697	                self.repository_state = before;
   698	            }
   699	            return Err(MutationError::Persistence(error));
   700	        }
   701	        Ok(resolution)
   702	    }
   703	
   704	    pub fn save(&mut self) {
   705	        if let Err(error) = self.save_checked() {
   706	            eprintln!("save state: {error}");
   707	        }
   708	    }
   709	
   710	    fn save_checked(&mut self) -> std::result::Result<(), persist::SaveError> {
   711	        if !self.persist {
   712	            return Ok(());
   713	        }
   714	        if self.persistence_blocked {
   715	            return Err(persist::SaveError::before_replacement(anyhow!(
   716	                "persistence is blocked after a state load failure"
   717	            )));
   718	        }
   719	        let state = StateFile::new(self.state_for_save());
   720	        #[cfg(test)]
   721	        let saved = if let Some((root, file)) = &self.persistence_target_for_test {
   722	            persist::save_current_at_test(root, file, &state, self.atomic_failure_for_test, None)
   723	        } else {
   724	            persist::save_for_workspace_status(STATE_BASE, baude_core::workspace::active(), &state)
   725	        };
   726	        #[cfg(not(test))]
   727	        let saved =
   728	            persist::save_for_workspace_status(STATE_BASE, baude_core::workspace::active(), &state);
   729	        match saved {
   730	            Ok(()) => {
   731	                self.persistence_dirty = false;
   732	                self.persistence_error = None;
   733	                Ok(())
   734	            }
   735	            Err(error) => {
   736	                self.persistence_dirty = true;
   737	                self.persistence_error = Some(error.to_string());
   738	                Err(error)
   739	            }
   740	        }
   741	    }
   742	
   743	    fn save_removal_revocation(&mut self) -> std::result::Result<(), persist::SaveError> {
   744	        let result = self.save_checked();
   745	        #[cfg(test)]
   746	        if result.is_err() {
   747	            self.atomic_failure_for_test = None;
   748	        }
   749	        result
   750	    }
   751	
   752	    pub fn persistence_status(&self) -> PersistenceStatus {
   753	        PersistenceStatus {
   754	            enabled: self.persist,
   755	            blocked: self.persistence_blocked,
   756	            dirty: self.persistence_dirty,
   757	            error: self.persistence_error.clone(),
   758	        }
   759	    }
   760	
   761	    #[cfg(test)]
   762	    fn save_at(&mut self, root: &Path, workspace: &baude_core::workspace::Workspace) {
   763	        if !self.persist || self.persistence_blocked {
   764	            return;
   765	        }
   766	        let file = workspace.state_file(STATE_BASE);
   767	        if let Err(error) =
   768	            persist::save_current_at(root, &file, &StateFile::new(self.state_for_save()))
   769	        {
   770	            self.persistence_dirty = true;
   771	            self.persistence_error = Some(error.to_string());
   772	            eprintln!("save state: {error}");
   773	        } else {
   774	            self.persistence_dirty = false;
   775	            self.persistence_error = None;
   776	        }
   777	    }
   778	
   779	    fn state_for_save(&self) -> RepositoryState {
   780	        let mut state = self.repository_state.clone();
   781	        for checkout in &mut state.checkouts {
   782	            let Some(runtime_id) = self.runtime_checkouts.get(&checkout.key) else {
   783	                continue;
   784	            };
   785	            let Some(session) = self
   786	                .sessions
   787	                .iter()
   788	                .find(|session| session.id == *runtime_id)
   789	            else {
   790	                continue;
   791	            };
   792	            checkout.session = RetainedSessionState {
   793	                name: session.name.clone(),
   794	                cwd: PersistedPath::from_path(&session.cwd),
   795	                repo_root: PersistedPath::from_path(&session.repo_root),
   796	                branch: session.branch.clone(),
   797	                is_worktree: session.is_worktree,
   798	                shell_open: session.shell_open,
   799	                archived: session.archived,
   800	                archived_by_user: session.archived_by_user,
   801	                resume_id: session
   802	                    .meta
   803	                    .session_id
   804	                    .clone()
   805	                    .or_else(|| checkout.session.resume_id.clone()),
   806	            };
   807	        }
   808	        state
   809	    }
   810	
   811	    /// `POST /sessions` — spawn a fresh session in `repo`, optionally in a
   812	    /// managed worktree for `worktree` (branch name).
   813	    pub fn create(
   814	        &mut self,
   815	        repo: &str,
   816	        worktree: Option<&str>,
   817	        name: Option<&str>,
   818	    ) -> MutationResult<SessionInfo> {
   819	        if self.persistence_blocked {
   820	            return Err(persist::SaveError::before_replacement(anyhow!(
   821	                "daemon persistence is blocked after a state load failure"
   822	            ))
   823	            .into());
   824	        }
   825	        // Guarded: a `~`-prefixed `repo` in a request body would otherwise
   826	        // stat the developer's real home from inside this crate's test binary.
   827	        let repo = persist::expand_tilde(repo);
   828	        let repo = repo.canonicalize().unwrap_or(repo);
   829	        if !repo.is_dir() {
   830	            return Err(anyhow!("not a directory: {}", repo.display()).into());
   831	        }
   832	        if let Some(branch) = worktree {
   833	            let outcome = self.activate_branch_worktree(&repo, branch, name)?;
   834	            let runtime = match outcome {
   835	                LifecycleOutcome::Created {
   836	                    runtime: Some(runtime),
   837	                    ..
   838	                }
   839	                | LifecycleOutcome::Activated {
   840	                    runtime: Some(runtime),
   841	                    ..
   842	                }
   843	                | LifecycleOutcome::Reused {
   844	                    runtime: Some(runtime),
   845	                    ..
   846	                }
   847	                | LifecycleOutcome::Focused { runtime, .. } => runtime,
   848	                LifecycleOutcome::Busy { .. } => {
   849	                    return Err(anyhow!("repository lifecycle is busy; retry the action").into())
   850	                }
   851	                _ => return Err(anyhow!("activation produced no runtime").into()),
   852	            };
   853	            return Ok(self
   854	                .info(runtime)
   855	                .expect("activation runtime just resolved"));
   856	        }
   857	        let (cwd, repo_root, branch, is_worktree) = match worktree {
   858	            Some(_) => unreachable!("worktree activation returned above"),
   859	            None => {
   860	                let root = git::repo_root(&repo).unwrap_or_else(|| repo.clone());
   861	                (repo, root, None, false)
   862	            }
   863	        };
   864	        if self.persist {
   865	            self.ensure_runtime_capacity(&cwd, &repo_root)?;

