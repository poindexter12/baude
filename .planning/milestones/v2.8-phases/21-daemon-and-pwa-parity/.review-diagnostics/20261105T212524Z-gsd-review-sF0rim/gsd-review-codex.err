    30	/// The flag appended to a base `claude` command in `skip` mode (and the
    31	/// default). Leading space lets the caller append directly to `base_cmd`.
    32	const SKIP_FLAG: &str = " --dangerously-skip-permissions";
    33	
    34	/// The flag appended in `prompt` mode. The MCP tool name follows the standard
    35	/// `mcp__<server>__<tool>` form (research §A); the `baude` server exposing the
    36	/// `approve` tool is registered via the seeded `.mcp.json`.
    37	const PROMPT_FLAG: &str = " --permission-prompt-tool mcp__baude__approve";
    38	
    39	/// Build the `claude` command to spawn for the current `BAUDE_PERMISSION_MODE`,
    40	/// applied to `base_cmd`. Reads the env; the env-free core is
    41	/// [`resolve_claude_cmd`] (split so tests never mutate the process-global var,
    42	/// which would race concurrent spawns — same pattern as `hook`).
    43	pub fn resolve_claude_cmd_env(base_cmd: &str) -> ResolvedCmd {
    44	    resolve_claude_cmd(
    45	        std::env::var("BAUDE_PERMISSION_MODE").ok().as_deref(),
    46	        base_cmd,
    47	    )
    48	}
    49	
    50	/// The spawn command plus whether a conflicting skip flag was stripped (so the
    51	/// caller can warn). `stripped_skip` is only ever `true` in `prompt` mode.
    52	#[derive(Debug, PartialEq, Eq)]
    53	pub struct ResolvedCmd {
    54	    pub cmd: String,
    55	    pub stripped_skip: bool,
    56	}
    57	
    58	/// Pure: resolve the spawn command for an explicit `mode` (`None` = unset).
    59	///
    60	/// `prompt` is an EXPLICIT opt-in and WINS over a `--dangerously-skip-permissions`
    61	/// baked into the operator's `claude_cmd` (BL-04 — that combination previously
    62	/// suppressed prompt mode silently via the old no-double-add short-circuit,
    63	/// leaving sessions in skip while baude still seeded `.mcp.json`). In `prompt`
    64	/// mode a conflicting skip flag is STRIPPED from `base_cmd` before [`PROMPT_FLAG`]
    65	/// is appended, and `stripped_skip` is set so the caller can warn. An
    66	/// operator-set `--permission-prompt-tool`/`--permission-mode` is still respected
    67	/// (no double-add) — they explicitly chose a prompt-style flag.
    68	///
    69	/// `skip`/default (unset, `"skip"`, any unrecognized value — fail-safe, T-04-01)
    70	/// keeps the original no-double-add: append [`SKIP_FLAG`] only when `base_cmd`
    71	/// carries no permission flag at all.
    72	pub fn resolve_claude_cmd(mode: Option<&str>, base_cmd: &str) -> ResolvedCmd {
    73	    let has_prompt = base_cmd.contains("--permission-prompt-tool");
    74	    let has_mode = base_cmd.contains("--permission-mode");
    75	    let has_skip = base_cmd.contains("--dangerously-skip-permissions");
    76	    match mode {
    77	        Some("prompt") => {
    78	            if has_prompt || has_mode {
    79	                // Operator explicitly set a prompt-style flag — respect it.
    80	                ResolvedCmd {
    81	                    cmd: base_cmd.to_string(),
    82	                    stripped_skip: false,
    83	                }
    84	            } else if has_skip {
    85	                // Explicit opt-in wins: drop the conflicting skip, add prompt.
    86	                let stripped = strip_token(base_cmd, "--dangerously-skip-permissions");
    87	                ResolvedCmd {
    88	                    cmd: format!("{stripped}{PROMPT_FLAG}"),
    89	                    stripped_skip: true,
    90	                }
    91	            } else {
    92	                ResolvedCmd {
    93	                    cmd: format!("{base_cmd}{PROMPT_FLAG}"),
    94	                    stripped_skip: false,
    95	                }
    96	            }
    97	        }
    98	        _ => {
    99	            let cmd = if has_prompt || has_mode || has_skip {
   100	                base_cmd.to_string()
   101	            } else {
   102	                format!("{base_cmd}{SKIP_FLAG}")
   103	            };
   104	            ResolvedCmd {
   105	                cmd,
   106	                stripped_skip: false,
   107	            }
   108	        }
   109	    }
   110	}
