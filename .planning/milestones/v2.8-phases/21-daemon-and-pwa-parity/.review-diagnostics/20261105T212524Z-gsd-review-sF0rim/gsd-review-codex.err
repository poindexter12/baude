  3956	                RowKey::Checkout(key) => self.runtime_checkouts.get(key).copied(),
  3957	                RowKey::Standalone(key) => self.runtime_standalones.get(key).copied(),
  3958	                RowKey::Repository(_) => None,
  3959	            };
