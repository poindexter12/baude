    32	
    33	    /// `claude --continue` resumes the most recent conversation; on a fresh
    34	    /// directory it exits non-zero and the `|| exec claude` fallback starts a
    35	    /// new session. The env var is set with `export VAR=...; <inner>` rather
    36	    /// than a `VAR=... cmd` assignment prefix: an assignment prefix applies
    37	    /// only to the single command it prefixes, so on the resume path the
    38	    /// `exec claude` fallback (the common fresh-directory case) would
    39	    /// otherwise run WITHOUT the var and its hooks would silently miss the
    40	    /// daemon transport. `export` sets it for the whole command group,
    41	    /// surviving the `||` fallback and sub-exec (WR-01).
    42	    fn spawn_plan(
    43	        &self,
    44	        resolved_cmd: &str,
    45	        event_url: Option<&str>,
    46	        mode: SpawnMode,
    47	    ) -> SpawnPlan {
    48	        let inner = match &mode {
    49	            SpawnMode::Fresh => format!("exec {resolved_cmd}"),
    50	            SpawnMode::ContinueLatest => {
    51	                format!("{resolved_cmd} --continue 2>/dev/null || exec {resolved_cmd}")
    52	            }
    53	            SpawnMode::ResumeId(_) => {
    54	                format!("exec {resolved_cmd} --resume \"${RESUME_ID_ENV}\"")
    55	            }
    56	        };
    57	        let cmd = match event_url {
    58	            Some(url) => format!("export BAUDE_EVENT_URL={url}; {inner}"),
    59	            None => inner,
    60	        };
    61	        SpawnPlan {
    62	            cmd,
    63	            env: mode.environment(),
    64	            server_port: None,
    65	        }
    66	    }
    67	
    68	    /// `claude --resume <id>` has no fallback: with no transcript for `<id>`
    69	    /// it prints "No conversation found" and exits, and the pane is dead. A
    70	    /// shell `|| exec claude` would hide that, but it would also silently
    71	    /// restart a real conversation that merely exited non-zero, so the check
    72	    /// happens here, before the mode is chosen.
    73	    ///
    74	    /// The id is untrusted persisted data: anything that is not a single
    75	    /// plain file-name component cannot be a transcript and never reaches the
    76	    /// filesystem. Both the given and the canonical cwd are tried, because
    77	    /// Claude keys its project dir by the path it sees, and on macOS a
    78	    /// `/tmp`- or `/var`-rooted cwd resolves to `/private/...`.
    79	    fn resume_target_exists(&self, cwd: &Path, id: &str) -> bool {
    80	        let mut components = Path::new(id).components();
    81	        if !matches!(
    82	            (components.next(), components.next()),
    83	            (Some(std::path::Component::Normal(name)), None) if name.to_str() == Some(id)
    84	        ) {
    85	            return false;
    86	        }
    87	        if crate::meta::transcript_file(cwd, id).is_file() {
    88	            return true;
    89	        }
    90	        std::fs::canonicalize(cwd)
    91	            .is_ok_and(|real| real != cwd && crate::meta::transcript_file(&real, id).is_file())
    92	    }
    93	
    94	    /// Seed `.claude/settings.local.json` so the spawned Claude fires baude's
    95	    /// lifecycle hooks, and — in `prompt` mode only — a non-clobbering
    96	    /// `.mcp.json` registering the `permission-mcp` stdio server. Both seeds
    97	    /// resolve `current_exe()`, so a daemon-spawned session wires `bauded`
    98	    /// and a TUI one wires `baude` (the Pitfall-2 reason both binaries carry
    99	    /// the `hook`/`permission-mcp` arms).
   100	    fn prepare_cwd(&self, cwd: &Path) -> Vec<crate::hook::SeedWarning> {
   101	        let mut warnings = crate::hook::seed_settings(cwd);
   102	        if crate::permission::is_prompt_mode() {
   103	            warnings.extend(seed_mcp_config(cwd));
   104	        }
   105	        warnings
   106	    }
