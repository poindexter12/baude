   573	    fn reconcile_activation_recoveries(&mut self) -> MutationResult<()> {
   574	        let recoveries: Vec<_> = self
   575	            .repository_state
   576	            .checkouts
   577	            .iter()
   578	            .filter_map(|checkout| {
   579	                matches!(
   580	                    checkout.health(),
   581	                    CheckoutHealth::Unavailable(
   582	                        UnavailableCause::PendingActivation { .. }
   583	                            | UnavailableCause::ActivationRecovery { .. }
   584	                    )
   585	                )
   586	                .then_some((checkout.repository_key, checkout.key))
   587	            })
   588	            .collect();
   589	        if recoveries.is_empty() {
   590	            return Ok(());
   591	        }
   592	        let before = self.repository_state.clone();
   593	        for (repository, checkout) in recoveries {
   594	            let _reservation = self
   595	                .repository_reservations
   596	                .reserve(repository)
   597	                .map_err(|busy| anyhow!("{busy:?}"))?;
   598	            lifecycle::reconcile_activation_recovery(&mut self.repository_state, checkout)
   599	                .map_err(anyhow::Error::new)?;
   600	        }
   601	        if let Err(error) = self.save_checked() {
   602	            if !error.replacement_committed() {
   603	                self.repository_state = before;
   604	            }
   605	            return Err(MutationError::Persistence(error));
   980	        }
