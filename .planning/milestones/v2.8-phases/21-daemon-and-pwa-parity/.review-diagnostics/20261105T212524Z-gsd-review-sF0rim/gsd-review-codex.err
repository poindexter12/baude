   521	pub(crate) enum RemoveProjectError {
   522	    /// The repository is reserved by another lifecycle operation.
   523	    Reservation(String),
   524	    /// The core refused or failed before any row dropped; every handle is
   525	    /// back in the registry.
   526	    Removal(baude_core::removal::RemovalError),
