    33	function esc(s) {
    34	  return String(s).replace(/[&<>"']/g, (c) => ({
    35	    "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;",
    36	  })[c]);
    37	}
    38	
    39	function humanMs(ms) {
    40	  const s = Math.floor(ms / 1000);
    41	  if (s < 60) return `${s}s`;
    42	  if (s < 3600) return `${Math.floor(s / 60)}m`;
    43	  return `${Math.floor(s / 3600)}h${Math.floor((s % 3600) / 60)}m`;
    44	}
    45	
    46	// "in 2h12m" until a unix-seconds timestamp (the 5h rate-limit reset), "now"
    47	// once elapsed. Mirrors the TUI's human_until for the per-session 5h chip.
    48	function untilShort(unixS) {
    49	  const ms = unixS * 1000 - Date.now();
    50	  return ms <= 0 ? "now" : "in " + humanMs(ms);
    51	}
    52	
    53	// BL-03: compact GSD chip "⬡ <milestone> ph<phase>" (both optional), so the PWA
    54	// surfaces GSD state like the TUI. Every dynamic field esc()'d. Null when no
    55	// GSD state is present (the session isn't GSD-tracked).
    56	function gsdChip(s) {
