   810	/// common dir on disk now, so a repository deleted outside baude is refused
   811	/// before the kill stage instead of after every runtime is already dead.
   812	fn probe_owner_common_dir(row: &PlannedRow) -> Result<(), RemovalError> {
   813	    if row.disk == DiskAction::KeepDirectory {
   814	        return Ok(());
   815	    }
   816	    let Some(path) = &row.path else {
   817	        return Ok(());
   818	    };
   819	    let common_dir = owner_common_dir(row, path)?;
   820	    match std::fs::symlink_metadata(common_dir) {
   821	        Ok(_) => Ok(()),
   822	        Err(error) => Err(disk_error(
   823	            row,
   824	            path,
   825	            DiskRemovalFailure {
   826	                kind: DiskRemovalFailureKind::Uninspectable,
   827	                detail: format!(
   828	                    "owning repository common dir {} is not on disk: {error}",
   829	                    common_dir.display()
   830	                ),
   831	            },
   832	        )),
   833	    }
   834	}
   835	
   836	/// Verify every handle against the persisted runtime of its row before any
   837	/// signal is sent: exactly one handle per live row, full `ProcessIdentity`
   838	/// equality for the agent, exact `ShellOwnership` agreement, and no handle
   839	/// at all for a row without a persisted runtime.
   840	fn preflight(set: &RemovalSet, runtimes: &[RowRuntime]) -> Result<(), RemovalError> {
   841	    for row in &set.rows {
   842	        probe_owner_common_dir(row)?;
   843	        let handles: Vec<&RowRuntime> = runtimes
   844	            .iter()
   845	            .filter(|handle| handle.row == row.row)
   846	            .collect();
   847	        if handles.len() > 1 {
   848	            return Err(RemovalError::RuntimeIdentityMismatch {
   849	                row: row.row,
   850	                detail: format!("duplicate handles supplied: {} for one row", handles.len()),
   851	            });
   852	        }
   853	        let Some(runtime) = &row.runtime else {
   854	            if !handles.is_empty() {
   855	                return Err(RemovalError::RuntimeIdentityMismatch {
   856	                    row: row.row,
   857	                    detail: "a handle was supplied for a row with no persisted runtime".to_string(),
   858	                });
   859	            }
   860	            continue;
   861	        };
   862	        let Some(handle) = handles.first() else {
   863	            return Err(RemovalError::RuntimeHandleMissing(row.row));
   864	        };
   865	        let found = handle.session.claude.process_identity();
   866	        if found != &runtime.agent {
   867	            return Err(RemovalError::RuntimeIdentityMismatch {
   868	                row: row.row,
   869	                detail: format!(
   870	                    "agent identity differs: expected pid {} start_time {} pgid {} sid {}, found pid {} start_time {} pgid {} sid {}",
   871	                    runtime.agent.pid,
   872	                    runtime.agent.start_time,
   873	                    runtime.agent.process_group,
   874	                    runtime.agent.session,
   875	                    found.pid,
   876	                    found.start_time,
   877	                    found.process_group,
   878	                    found.session,
   879	                ),
   880	            });
   881	        }
   882	        let live_shell = handle.session.shell.as_ref().map(Pty::process_identity);
   883	        match (&runtime.shell, live_shell) {
   884	            (ShellOwnership::Closed, None) => {}
   885	            (ShellOwnership::Closed, Some(found)) => {
   886	                return Err(RemovalError::RuntimeIdentityMismatch {
   887	                    row: row.row,
   888	                    detail: format!(
   889	                        "persisted shell ownership is closed but the handle carries a live shell pid {}",
   890	                        found.pid
   891	                    ),
   892	                });
   893	            }
   894	            (ShellOwnership::Owned(expected), Some(found)) if found == expected => {}
   895	            (ShellOwnership::Owned(expected), found) => {
   896	                return Err(RemovalError::RuntimeIdentityMismatch {
   897	                    row: row.row,
   898	                    detail: format!(
   899	                        "shell identity differs: expected pid {} start_time {}, found {}",
   900	                        expected.pid,
   901	                        expected.start_time,
   902	                        found.map_or_else(
   903	                            || "no shell".to_string(),
   904	                            |f| format!("pid {} start_time {}", f.pid, f.start_time)
   905	                        ),
   906	                    ),
   907	                });
   908	            }
   909	        }
   910	    }
   911	    Ok(())
   912	}
   913	
   914	/// Stop every live row in `set.rows` order through its verified handle,
   915	/// aborting on the first survivor so disk and state stay untouched.
   916	fn kill_stage(
   917	    set: &RemovalSet,
   918	    runtimes: &mut [RowRuntime],
   919	) -> Result<Vec<KilledRuntime>, RemovalError> {
   920	    let mut killed = Vec::new();
   921	    for row in &set.rows {
   922	        if row.runtime.is_none() {
   923	            continue;
   924	        }
   925	        let handle = runtimes
   926	            .iter_mut()
   927	            .find(|handle| handle.row == row.row)
   928	            .ok_or(RemovalError::RuntimeHandleMissing(row.row))?;
   929	        handle
   930	            .session
   931	            .kill_and_wait()
   932	            .map_err(|error| RemovalError::RuntimeSurvived {
   933	                row: row.row,
   934	                error: Box::new(error),
   935	            })?;
   936	        killed.push(KilledRuntime {
   937	            row: row.row,
   938	            agent_pid: handle.session.claude.process_identity().pid,
   939	            shell_pid: handle
   940	                .session
   941	                .shell
   942	                .as_ref()
   943	                .map(|shell| shell.process_identity().pid),
   944	        });
   945	    }
   946	    Ok(killed)
   947	}
   948	
   949	/// Paths the disk stage deleted, kept and found already gone.
   950	struct DiskResults {
   951	    deleted: Vec<PathBuf>,
   952	    kept: Vec<PathBuf>,
   953	    already_removed: Vec<PathBuf>,
   954	}
   955	
   956	/// Apply each row's `DiskAction`. A managed directory that is already gone
   957	/// still goes through the forced helper so its own administrative entry is
   958	/// dropped. The report follows what the helper did, not what `select_rows`
   959	/// planned: a directory that reappeared since the plan and was deleted is
   960	/// reported as deleted, and one that reappeared unregistered and without a
   961	/// removal marker is a `NotRegistered` failure rather than a silent drop,
   962	/// since a directory now sits at the row's path. `NotRegistered` with the
   963	/// path still absent means there was nothing left to clean.
   964	fn disk_stage(set: &RemovalSet) -> Result<DiskResults, RemovalError> {
   965	    let mut results = DiskResults {
   966	        deleted: Vec::new(),
   967	        kept: Vec::new(),
   968	        already_removed: Vec::new(),
   969	    };
   970	    for row in &set.rows {
   971	        let Some(path) = &row.path else {
   972	            continue;
   973	        };
   974	        match row.disk {
   975	            DiskAction::KeepDirectory => results.kept.push(path.clone()),
   976	            DiskAction::RemoveManagedWorktree | DiskAction::AlreadyRemoved => {
   977	                let common_dir = owner_common_dir(row, path)?;
   978	                match crate::git::remove_managed_worktree_forced(common_dir, path) {
   979	                    Ok(removal) if removal.deleted_directory => results.deleted.push(path.clone()),
   980	                    Ok(_) => results.already_removed.push(path.clone()),
   981	                    Err(crate::git::ForcedRemovalError::NotRegistered { .. })
   982	                        if matches!(
   983	                            std::fs::symlink_metadata(path),
   984	                            Err(ref error) if error.kind() == ErrorKind::NotFound
   985	                        ) =>
   986	                    {
   987	                        results.already_removed.push(path.clone())
   988	                    }
   989	                    Err(error) => return Err(disk_error(row, path, error.into())),
   990	                }
   991	            }
   992	        }
   993	    }
   994	    Ok(results)
   995	}
   996	
   997	/// The owning repository's common directory, which `select_rows` records on
   998	/// every checkout row. The main worktree is deliberately not consulted: the
   999	/// forced helper runs against the common dir so a vanished main checkout
  1000	/// does not strand its managed children.
  1001	fn owner_common_dir<'a>(row: &'a PlannedRow, path: &Path) -> Result<&'a Path, RemovalError> {
  1002	    match &row.common_dir {
  1003	        Some(common_dir) => Ok(common_dir),
  1004	        None => Err(disk_error(
  1005	            row,
  1006	            path,
  1007	            DiskRemovalFailure {
  1008	                kind: DiskRemovalFailureKind::NotRegistered,
  1009	                detail: "managed row carries no owning repository".to_string(),
  1010	            },
  1011	        )),
  1012	    }
  1013	}
  1014	
  1015	fn disk_error(row: &PlannedRow, path: &Path, error: DiskRemovalFailure) -> RemovalError {
  1016	    RemovalError::DiskRemoval {
  1017	        row: row.row,
  1018	        path: path.to_path_buf(),
  1019	        error,
  1020	    }
  1021	}
  1022	
  1023	/// Save the candidate once. Commits `*state` and consumes the removed rows'
  1024	/// handles on `Ok` or on a committed replacement; otherwise leaves both
  1025	/// untouched. The parked-reader sweep runs while the handles are still
  1026	/// owned, so a reader left behind an out-of-group slave holder is reported
  1027	/// rather than detached silently.
  1028	fn persist_stage(
  1029	    state: &mut RepositoryState,
  1030	    candidate: RepositoryState,
  1031	    set: &RemovalSet,
  1032	    runtimes: &mut Vec<RowRuntime>,
  1033	    save: impl FnOnce(&crate::persist::StateFile) -> Result<(), crate::persist::SaveError>,
  1034	) -> Result<(PersistenceOutcome, Vec<RowKey>), RemovalError> {
  1035	    let file = crate::persist::StateFile {
  1036	        schema_version: crate::persist::SCHEMA_VERSION,
  1037	        state: candidate,
  1038	    };
  1039	    let persistence = match save(&file) {
  1040	        Ok(()) => PersistenceOutcome::Saved,
  1041	        Err(error) if error.replacement_committed() => PersistenceOutcome::SavedDegraded {
  1042	            detail: error.to_string(),
  1043	        },
  1044	        Err(error) => return Err(RemovalError::Persist { error }),
  1045	    };

